<UserControl x:Class="SmartPoultry.Inventory_OrderSupplyProductControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SmartPoultry"
             mc:Ignorable="d" 
             d:DesignHeight="44" d:DesignWidth="370">
    <Grid>
        <Border BorderBrush="White" BorderThickness="1" Background="White">
            <WrapPanel>
                <Label x:Name="NameLabel" Content="name" Height="32" Width="143"/>
                <Label x:Name="StocksLabel" Content="Stcks" Height="32" Width="71"/>
                <Button x:Name="minusBtn" Height="26" Width="30" BorderBrush="Transparent" Background="Transparent" Click="minusBtn_Click">
                    <Image Height="20" Width="23" Source="/Images/minusorder.png"/>
                </Button>
                <Label x:Name="QTYLabel" Content="1" Height="32" Width="15" />
                <Button x:Name="AddBtn" Height="26" Width="30" BorderBrush="Transparent" Background="Transparent" Click="AddBtn_Click" >
                    <Image Height="22" Width="24" Source="/Images/addorder.png"/>
                </Button>
                <Button Height="26" Width="30" BorderBrush="Transparent" Background="Transparent" Click="Remove_Clicked">
                    <Image Height="20" Width="25" Source="/Images/removeorder.png"/>
                </Button>
            </WrapPanel>
        </Border>

    </Grid>
</UserControl>
