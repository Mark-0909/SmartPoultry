<Window x:Class="SmartPoultry.Inventory_Unitadder"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartPoultry"
        mc:Ignorable="d"
        Title="Inventory_Unitadder" Height="202" Width="340" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterScreen" WindowStyle="None" Background="Transparent">
    <Grid>
        <Border CornerRadius="10" BorderBrush="#FF077C5E" BorderThickness="1" Background="White">
            <Border CornerRadius="10 10 0 0" BorderBrush="#FF077C5E" BorderThickness="1" HorizontalAlignment="Center" Height="31" Margin="0,-1,0,0" VerticalAlignment="Top" Width="340" Background="#FF077C5E">
                <Label x:Name="modeLabel" Content="Mode type" HorizontalAlignment="Center" VerticalAlignment="Top" Foreground="White" FontSize="18" Margin="0,-5,0,0"/>
            </Border>
        </Border>
        <Button x:Name="CloseButton" HorizontalAlignment="Left" Height="25" Margin="310,3,0,0" VerticalAlignment="Top" Width="27" Click="CloseButton_Click" Background="Transparent" BorderBrush="Transparent">
            <Image Height="20" Width="24" Source="/Images/close.png"/>
        </Button>
        <Border CornerRadius="0 0 10 10" BorderBrush="#FF077C5E" BorderThickness="1" HorizontalAlignment="Center" Height="30" VerticalAlignment="Top" Width="340" Background="#FF077C5E" Margin="0,172,0,0">
            <Button x:Name="submitBtn" Content="Submit" HorizontalAlignment="Center" Height="30" VerticalAlignment="Center" Width="332" Click="SubmitButton_Click" BorderBrush="#FF077C5E" Background="#FF077C5E" Foreground="White" FontSize="20"/>
        </Border>
        <Label Content="Unit Label: " HorizontalAlignment="Left" Margin="10,39,0,0" VerticalAlignment="Top" FontSize="15"/>
        <Label Content="Price: " HorizontalAlignment="Left" Margin="10,101,0,0" VerticalAlignment="Top" FontSize="15"/>
        <Label x:Name="stocksName" Content="Stocks:" HorizontalAlignment="Left" Margin="189,39,0,0" VerticalAlignment="Top" FontSize="15" RenderTransformOrigin="0.526,0.546"/>
        <Label x:Name="conversionName" Content="/baseunit" HorizontalAlignment="Left" Margin="236,129,0,0" VerticalAlignment="Top" FontSize="15"/>
        <Border CornerRadius="5" BorderBrush="#FF077C5E" BorderThickness="1" HorizontalAlignment="Left" Height="25" Margin="10,131,0,0" VerticalAlignment="Top" Width="101">
            <TextBox x:Name="priceTextBox" HorizontalAlignment="Center" TextWrapping="Wrap" Text="Price..." VerticalAlignment="Top" Width="94" FontSize="14" Height="18" Margin="0,1,0,0" BorderBrush="White" SelectionBrush="White" Foreground="Gray" GotFocus="PriceTB_GotFocused" LostFocus="PriceTB_LostFocused" TextChanged="PriceTB_TextChanged">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="SelectionBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="Transparent"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
        </Border>
        <Border CornerRadius="5" BorderBrush="#FF077C5E" BorderThickness="1" HorizontalAlignment="Left" Height="25" Margin="10,65,0,0" VerticalAlignment="Top" Width="155">
            <TextBox x:Name="unitLabelTextbox" VerticalContentAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" Text="Unit..." VerticalAlignment="Top" Width="146" FontSize="14" Height="18" BorderBrush="White" SelectionBrush="White" Foreground="Gray" Margin="0,1,0,0" GotFocus="UnitLabelTB_GotFocused" LostFocus="UnitLabelTB_LostFocused">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="SelectionBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="Transparent"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
        </Border>
        <Border x:Name="stocksBorder" CornerRadius="5" BorderBrush="#FF077C5E" BorderThickness="1" HorizontalAlignment="Left" Height="25" Margin="189,65,0,0" VerticalAlignment="Top" Width="98">
            <TextBox x:Name="stocksTextBox" HorizontalAlignment="Center" TextWrapping="Wrap" Text="Stocks..." VerticalAlignment="Top" Width="89" FontSize="14" Height="18" Margin="0,1,0,0" BorderBrush="White" SelectionBrush="White" Foreground="Gray" GotFocus="StocksTB_GotFocused" LostFocus="StocksTB_LostFocused" TextChanged="StocksTB_TextChanged">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="SelectionBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="Transparent"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
        </Border>
        <Label x:Name="conversionLabel" Content="Conversion:" HorizontalAlignment="Center" Margin="0,101,0,0" VerticalAlignment="Top" FontSize="15"/>
        <Border x:Name="conversionBorder" CornerRadius="5" BorderBrush="#FF077C5E" BorderThickness="1" HorizontalAlignment="Left" Height="25" Margin="126,131,0,0" VerticalAlignment="Top" Width="101">
            <TextBox x:Name="conversionTextbox" HorizontalAlignment="Center" TextWrapping="Wrap" Text="Conversion..." VerticalAlignment="Top" Width="94" FontSize="14" Height="18" Margin="0,1,0,0" BorderBrush="White" SelectionBrush="White" Foreground="Gray" GotFocus="ConversionTB_GotFocused" LostFocus="ConversionTB_LostFocused" TextChanged="ConversionTB_TextChanged">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="SelectionBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="Transparent"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
        </Border>

    </Grid>
</Window>
