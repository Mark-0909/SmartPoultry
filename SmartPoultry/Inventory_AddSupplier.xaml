<Window x:Class="SmartPoultry.Inventory_AddSupplier"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartPoultry"
        mc:Ignorable="d"
        Title="Inventory_AddingForm" Height="455" Width="434" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="None" Background="Transparent" ShowInTaskbar="False" AllowsTransparency="True">
    <Window.Resources>
        <Style x:Key="NoHoverButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation 
                                                Storyboard.TargetProperty="Opacity" 
                                                To=".7" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation 
                                                Storyboard.TargetProperty="Opacity" 
                                                To="1.0" Duration="0:0:0.3" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Combobox Style -->
        <Style x:Key="ComboboxStyle" TargetType="{x:Type ComboBox}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition MaxWidth="18"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Name="PART_EditableTextBox"
                             Padding="5,0,0,0"
                             BorderBrush="White"
                             IsReadOnly="True"
                             Height="{TemplateBinding Height}"/>
                            <ToggleButton x:Name="PART_DropDownButton" Grid.Column="1" Margin="0"
                                  Height="{TemplateBinding Height}"
                                  Focusable="False"
                                  Background="LightGray"
                                  BorderBrush="LightGray"
                                  IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                  ClickMode="Press">
                                <Path Grid.Column="1"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Data="M 0 0 L 4 4 L 8 0 Z"
                              Fill="Green"/>
                            </ToggleButton>
                            <ContentPresenter Name="ContentSite"
                                      Content="{TemplateBinding SelectionBoxItem}"
                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left"
                                      Margin="5,0,0,0"/>
                            <Popup Name="Popup"
                           Placement="Bottom"
                           IsOpen="{TemplateBinding IsDropDownOpen}"
                           AllowsTransparency="True"
                           Focusable="False"
                           PopupAnimation="Slide">
                                <Grid Name="DropDown"
                              SnapsToDevicePixels="True"
                              MinWidth="{TemplateBinding ActualWidth}"
                              MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Background="White"
                                    BorderBrush="White"/>
                                    <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True"
                                             KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComboboxButtonStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border Background="White"
                        x:Name="border"
                        CornerRadius="0,5,5,0"
                        BorderThickness="0,1,1,1"
                        BorderBrush="Black">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


    </Window.Resources>

    <Grid>

        <Border x:Name="AddingFormOverlay" Opacity=".5"  CornerRadius="10" BorderBrush="Transparent" Background="#FFA7A7A7" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" Height="390" Width="434"/>



        <Border CornerRadius="10" BorderBrush="#FF077C5E" BorderThickness="2" Background="#FFDDDDDD">
            <Border CornerRadius="10 10 0 0" BorderThickness="1" Margin="-2,-2,-2,410" Background="#FF2C6E5D" BorderBrush="#FF2C6E5D">
                <Button Margin="388,2,4,2" Click="CloseAddPopup_Click" Background="Transparent" BorderBrush="Transparent" RenderTransformOrigin="0.5,0.5">
                    <Button.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="-1"/>
                            <SkewTransform/>
                            <RotateTransform/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </Button.RenderTransform>
                    <Image Height="28" Width="36" Source="/Images/close.png"/>
                </Button>
            </Border>
        </Border>
        <Label x:Name="windowName" HorizontalContentAlignment="Center"  Content="ADD SUPPLIER" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="25" Width="262" Height="41" Foreground="White" FontStretch="SemiExpanded" Margin="0,-1,0,0"/>

        <Border x:Name="typeFeedsBorder_Copy3" Height="35" Width="434" VerticalAlignment="Top" 
            Margin="0,420,0,0" HorizontalAlignment="Center" CornerRadius="0 0 10 10" 
            BorderThickness="1" BorderBrush="#FF077C5E" Background="#FF077C5E">
            <Button x:Name="SubmitBtn" Content="Submit" Margin="9,-1,26,-1" Click="Submit_Click" Background="#FF077C5E" Foreground="White" FontWeight="Bold" FontSize="20" BorderThickness="0" Style="{StaticResource NoHoverButton}"/>
        </Border>
        <Label Content="Supplier Name:" HorizontalAlignment="Left" Height="28" Margin="10,70,0,0" VerticalAlignment="Top" Width="133"/>
        <Border x:Name="typeFeedsBorder_Copy" Height="35" Width="414" VerticalAlignment="Top" 
            Margin="0,98,0,0" HorizontalAlignment="Center" CornerRadius="5" 
            BorderThickness="1" BorderBrush="White" Background="White">
            <TextBox x:Name="SupplierNameTB" BorderBrush="White" Tag="Supplier Name..." VerticalContentAlignment="Center" HorizontalAlignment="Center" Height="30" TextWrapping="Wrap" Text="Supplier Name..." VerticalAlignment="Center" Width="394" Foreground="#FF6F6F6F" GotFocus="TB_GotFocus" LostFocus="TB_LostFocus">
                <TextBox.Style>
                    <Style TargetType="{x:Type TextBox}">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="SelectionBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="Transparent"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
        </Border>
        <Label Content="Contact Person:" HorizontalAlignment="Left" Height="28" Margin="10,133,0,0" VerticalAlignment="Top" Width="133"/>
        <Border x:Name="typeFeedsBorder_Copy1" Height="35" Width="414" VerticalAlignment="Top" 
            Margin="0,161,0,0" HorizontalAlignment="Center" CornerRadius="5" 
            BorderThickness="1" BorderBrush="White" Background="White">
            <TextBox x:Name="ContactPersonTB" BorderBrush="White" Tag="Contact Person..." VerticalContentAlignment="Center" HorizontalAlignment="Center" Height="30" TextWrapping="Wrap" Text="Contact Person..." VerticalAlignment="Center" Width="394" Foreground="#FF6F6F6F" GotFocus="TB_GotFocus" LostFocus="TB_LostFocus">
                <TextBox.Style>
                    <Style TargetType="{x:Type TextBox}">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="SelectionBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="Transparent"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
        </Border>
        <Label Content="Location:" HorizontalAlignment="Left" Height="28" Margin="10,261,0,0" VerticalAlignment="Top" Width="133"/>
        <Border x:Name="typeFeedsBorder_Copy2" Height="35" Width="414" VerticalAlignment="Top" 
            Margin="0,289,0,0" HorizontalAlignment="Center" CornerRadius="5" 
            BorderThickness="1" BorderBrush="White" Background="White">
            <TextBox x:Name="LocationTB" BorderBrush="White" Tag="Location..." VerticalContentAlignment="Center" HorizontalAlignment="Center" Height="30" TextWrapping="Wrap" Text="Location..." VerticalAlignment="Center" Width="394" Foreground="#FF6F6F6F" GotFocus="TB_GotFocus" LostFocus="TB_LostFocus">
                <TextBox.Style>
                    <Style TargetType="{x:Type TextBox}">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="SelectionBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="Transparent"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>

            </TextBox>
        </Border>
        <Label Content="Email:" HorizontalAlignment="Left" Height="28" Margin="10,324,0,0" VerticalAlignment="Top" Width="133"/>
        <Border x:Name="typeFeedsBorder_Copy4" Height="35" Width="414" VerticalAlignment="Top" 
            Margin="0,353,0,0" HorizontalAlignment="Center" CornerRadius="5" 
            BorderThickness="1" BorderBrush="White" Background="White">
            <TextBox x:Name="EmailTB" BorderBrush="White" Tag="Email..." VerticalContentAlignment="Center" HorizontalAlignment="Center" Height="30" TextWrapping="Wrap" Text="Email..." VerticalAlignment="Center" Width="394" Foreground="#FF6F6F6F" GotFocus="TB_GotFocus" LostFocus="TB_LostFocus">
                <TextBox.Style>
                    <Style TargetType="{x:Type TextBox}">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="SelectionBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="Transparent"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
        </Border>
        <Label Content="Contact:" HorizontalAlignment="Left" Height="28" Margin="10,196,0,0" VerticalAlignment="Top" Width="133"/>
        <Border x:Name="typeFeedsBorder_Copy5" Height="35" Width="414" VerticalAlignment="Top" 
            Margin="0,224,0,0" HorizontalAlignment="Center" CornerRadius="5" 
            BorderThickness="1" BorderBrush="White" Background="White">
            <TextBox x:Name="ContactTB" BorderBrush="White" Tag="Contact..." VerticalContentAlignment="Center" HorizontalAlignment="Center" Height="30" TextWrapping="Wrap" Text="Contact..." VerticalAlignment="Center" Width="394" Foreground="#FF6F6F6F" GotFocus="TB_GotFocus" LostFocus="TB_LostFocus" TextChanged="ContactTB_TextChanged">
                <TextBox.Style>
                    <Style TargetType="{x:Type TextBox}">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="SelectionBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="Transparent"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
        </Border>

        <Border x:Name="NotifPopup"  CornerRadius="10" BorderBrush="#FFCCE6D3" BorderThickness="1" HorizontalAlignment="Center" Height="46" Margin="0,23,0,0" VerticalAlignment="Top" Width="330" Background="#FFCCE6D3">
            <WrapPanel>
                <Label x:Name="NotifMessage"  Content="Invalid Credentials" VerticalContentAlignment="Center" Padding="20 0 0 0" Height="43" Width="302" Foreground="#FF666666"/>
                <Button x:Name="NotifCloseBtn" BorderBrush="Transparent" Background="Transparent" Height="20" Width="21" Click="NotifCloseBtn_Click">
                    <Image Height="16" Width="10" Source="/Images/closegray.png"/>
                </Button>
            </WrapPanel>
        </Border>

    </Grid>
</Window>
