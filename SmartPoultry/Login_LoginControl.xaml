<UserControl x:Class="SmartPoultry.Login_LoginControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SmartPoultry"
             mc:Ignorable="d" Width="390" Height="318">
    <UserControl.Resources>
        <!-- Custom Style for TextBox -->
        <Style x:Key="NoFocusBorderTextBox" TargetType="TextBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="BorderBrush" Value="Gray" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="5" />
            <Style.Triggers>
                <!-- Remove border on focus -->
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="Transparent" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Border CornerRadius="10" BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Center" Height="318" VerticalAlignment="Center" Width="390" Background="#FF9AB989"/>
        <Button HorizontalContentAlignment="Left" Content="Create Account" HorizontalAlignment="Left" Height="19" Margin="53,212,0,0" VerticalAlignment="Top" Width="100" Background="Transparent" BorderBrush="Transparent" FontWeight="Bold" Click="CreateAccount_Clicked"/>
        <Button HorizontalContentAlignment="Right" Content="Forgot Password?" HorizontalAlignment="Left" Height="19" Margin="225,212,0,0" VerticalAlignment="Top" Width="111" Background="Transparent" BorderBrush="Transparent" FontWeight="Bold" Click="ForgotPass_Clicked"/>
        <Label Content="Username: " HorizontalAlignment="Left" Height="26" Margin="54,80,0,0" VerticalAlignment="Top" Width="132" FontSize="15"/>
        <Label Content="Password: " HorizontalAlignment="Left" Height="26" Margin="54,149,0,0" VerticalAlignment="Top" Width="144" FontSize="15"/>
        <Button Click="Submit_Clicked" x:Name="SubmitBtn" Content="LOGIN" HorizontalAlignment="Center" Height="34" Margin="0,249,0,0" VerticalAlignment="Top" Width="282" FontWeight="Bold"/>
        <Label HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Content="LOGIN" HorizontalAlignment="Center" Height="43" Margin="0,10,0,0" VerticalAlignment="Top" Width="390" FontSize="30" FontWeight="Bold"/>
        <Border CornerRadius="5                 " BorderBrush="DarkGray" BorderThickness="1" HorizontalAlignment="Center" Height="33" Margin="0,111,0,0" VerticalAlignment="Top" Width="282" Background="White">
            <TextBox x:Name="usernameTB" VerticalContentAlignment="Center" HorizontalAlignment="Center" Height="25" TextWrapping="Wrap" Text="Enter Username..." VerticalAlignment="Center" Width="268" Padding="1" Background="Transparent" BorderBrush="Transparent" FontSize="14" GotFocus="UserName_GotFocus" LostFocus="UserName_LostFocus" Foreground="Gray" >
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="SelectionBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="Transparent"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
        </Border>
        <Border CornerRadius="5                 " BorderBrush="DarkGray" BorderThickness="1" HorizontalAlignment="Center" Height="33" Margin="0,180,0,0" VerticalAlignment="Top" Width="282" Background="White">
            <PasswordBox x:Name="passwordTB" HorizontalAlignment="Right" Height="25" VerticalAlignment="Center" Width="270" Background="Transparent" BorderBrush="Transparent" VerticalContentAlignment="Center" Padding="1" Margin="0,0,5,0" LostFocus="PassTB_LostFocus">
                <PasswordBox.Style>
                    <Style TargetType="PasswordBox">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="SelectionBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="Transparent"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </PasswordBox.Style>
            </PasswordBox>
        </Border>
        <TextBox x:Name="passwordoverTB" VerticalContentAlignment="Center" HorizontalAlignment="Center" Height="25" TextWrapping="Wrap" Text="Enter Password..." VerticalAlignment="Top" Width="268" Padding="1" Background="Transparent" BorderBrush="Transparent" FontSize="14" Foreground="Gray" Margin="0,184,0,0" GotFocus="PassOverTB_GotFocus">
            <TextBox.Style>
                <Style TargetType="TextBox">
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="SelectionBrush" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="Transparent"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TextBox.Style>
        </TextBox>

    </Grid>
</UserControl>
