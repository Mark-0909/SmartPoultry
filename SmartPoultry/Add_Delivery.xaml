<Window x:Class="SmartPoultry.Add_Delivery"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartPoultry"
        mc:Ignorable="d"
        Title="Add_Delivery" Height="487" Width="432" WindowStartupLocation="CenterScreen" Background="Transparent" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True">
    <Grid>
        <Border CornerRadius="10" BorderBrush="#FF2C6E5D" Background="White" BorderThickness="1">
            <Border CornerRadius="10 10 0 0" BorderBrush="#FF2C6E5D" BorderThickness="1" HorizontalAlignment="Center" Height="38" Margin="0,-1,0,0" VerticalAlignment="Top" Width="432" Background="#FF2C6E5D">
                <Button Click="Close_Click" HorizontalAlignment="Left" Height="27" Margin="394,0,0,0" VerticalAlignment="Center" Width="31" Background="#FF2C6E5D" BorderBrush="#FF2C6E5D">
                    <Image Height="24" Width="19" Source="/Images/close.png"/>
                </Button>
            </Border>
        </Border>
        <Label HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Content="ADD DELIVERY" HorizontalAlignment="Center" Height="35" VerticalAlignment="Top" Width="220" FontSize="20" Foreground="White" FontWeight="Bold"/>
        <Border CornerRadius="0 0 10 10" BorderBrush="#FF2C6E5D" BorderThickness="1" HorizontalAlignment="Center" Height="32" Margin="0,455,0,0" VerticalAlignment="Top" Width="432" Background="#FF2C6E5D">
            <Button Content="CONFIRM" HorizontalAlignment="Center" Height="27" VerticalAlignment="Center" Width="412" BorderBrush="#FF2C6E5D" Background="#FF2C6E5D" FontSize="15" Click="ConfirmButton_Click" Foreground="White" FontWeight="Bold"/>
        </Border>
        <Label Content="Name: " HorizontalAlignment="Left" Height="30" Margin="8,40,0,0" VerticalAlignment="Top" Width="96" FontSize="14"/>
        <Label Content="Address:" HorizontalAlignment="Left" Height="26" Margin="8,138,0,0" VerticalAlignment="Top" Width="83" FontSize="14"/>
        <Label Content="Type:" HorizontalAlignment="Left" Height="30" Margin="10,196,0,0" VerticalAlignment="Top" Width="96" FontSize="14"/>
        <RadioButton x:Name="toDeliverRadio" Checked="ToDeliver_IsChecked"  IsChecked="True" GroupName="Type" VerticalContentAlignment="Center" Content="To Deliver" HorizontalAlignment="Left" Height="21" Margin="10,226,0,0" VerticalAlignment="Top" Width="90" FontSize="14"/>
        <RadioButton x:Name="toReceiveRadio" Checked="ToReceive_IsChecked"  GroupName="Type" VerticalContentAlignment="Center" Content="To Receive" HorizontalAlignment="Left" Height="21" Margin="100,226,0,0" VerticalAlignment="Top" Width="90" FontSize="14"/>
        <Label Content="Delivery Date: " HorizontalAlignment="Left" Height="30" Margin="10,305,0,0" VerticalAlignment="Top" Width="96" FontSize="14"/>
        <Label Content="Payment Mode:" HorizontalAlignment="Left" Height="30" Margin="10,247,0,0" VerticalAlignment="Top" Width="116" FontSize="14"/>
        <RadioButton x:Name="CashRadio" Checked="CashRadio_IsChecked"  IsChecked="True" GroupName="Mode"  VerticalContentAlignment="Center" Content="Cash" HorizontalAlignment="Left" Height="21" Margin="10,279,0,0" VerticalAlignment="Top" Width="90" FontSize="14"/>
        <RadioButton x:Name="GcashRadio" Checked="GCashRadio_IsChecked"  GroupName="Mode" VerticalContentAlignment="Center" Content="GCash" HorizontalAlignment="Left" Height="21" Margin="100,279,0,0" VerticalAlignment="Top" Width="90" FontSize="14"/>
        <Label Content="Contacts:" HorizontalAlignment="Left" Height="30" Margin="10,369,0,0" VerticalAlignment="Top" Width="96" RenderTransformOrigin="0.515,1.038" FontSize="14"/>
        <Label Content="Price:" HorizontalAlignment="Left" Height="30" Margin="230,196,0,0" VerticalAlignment="Top" Width="96" RenderTransformOrigin="0.515,1.038" FontSize="14"/>
        <Label Content="Status: " HorizontalAlignment="Left" Height="30" Margin="229,247,0,0" VerticalAlignment="Top" Width="96" FontSize="14"/>
        <RadioButton x:Name="PaidRadio" Checked="PaidRadio_IsChecked"  IsChecked="True" GroupName="Status"  VerticalContentAlignment="Center" Content="Paid" HorizontalAlignment="Left" Height="21" Margin="230,279,0,0" VerticalAlignment="Top" Width="90" FontSize="14"/>
        <RadioButton x:Name="UnpaidRadio" Checked="UnpaidRadio_IsChecked"   GroupName="Status"  VerticalContentAlignment="Center" Content="Unpaid" HorizontalAlignment="Left" Height="21" Margin="322,279,0,0" VerticalAlignment="Top" Width="90" FontSize="14"/>
        <Label Content="Delivery Man: " HorizontalAlignment="Left" Height="30" Margin="230,305,0,0" VerticalAlignment="Top" Width="96" FontSize="14"/>
        <Label Content="Charge: " HorizontalAlignment="Left" Height="29" Margin="230,370,0,0" VerticalAlignment="Top" Width="96" FontSize="14"/>
        <Border CornerRadius="5" BorderBrush="Gray" BorderThickness="1" HorizontalAlignment="Left" Height="30" Margin="10,404,0,0" VerticalAlignment="Top" Width="204">
            <TextBox x:Name="ContactsTextBox" VerticalContentAlignment="Center" HorizontalAlignment="Center" Height="23" TextWrapping="Wrap" Text="Contact..." VerticalAlignment="Center" Width="192" BorderBrush="Transparent" Foreground="Gray" GotFocus="ContactsTB_GotFocus" LostFocus="ContactsTB_LostFocus" FontSize="14">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="SelectionBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="Transparent"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
        </Border>
        <Border CornerRadius="5" BorderBrush="Gray" BorderThickness="1" HorizontalAlignment="Left" Height="30" Margin="8,332,0,0" VerticalAlignment="Top" Width="204">
            <DatePicker x:Name="datePicker" 
            VerticalContentAlignment="Center" 
            HorizontalAlignment="Center" 
            Height="24" 
            VerticalAlignment="Center" 
            Width="192" 
            Loaded="DatePicker_Loaded" 
            Foreground="Gray" FontSize="14">
                <!-- Style for DatePicker -->
                <DatePicker.Style>
                    <Style TargetType="DatePicker">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Foreground" Value="Gray" />

                        <Style.Triggers>
                            <!-- Remove hover effect -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="Background" Value="Transparent" />
                            </Trigger>
                            <!-- Remove keyboard focus effect -->
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="Transparent" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DatePicker.Style>

                <!-- Style for internal TextBox -->
                <DatePicker.Resources>
                    <Style TargetType="TextBox">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />

                        <Style.Triggers>
                            <!-- Remove hover effect for TextBox -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="Transparent" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DatePicker.Resources>
            </DatePicker>


        </Border>
        <Border CornerRadius="5" BorderBrush="Gray" BorderThickness="1" HorizontalAlignment="Left" Height="30" Margin="230,404,0,0" VerticalAlignment="Top" Width="182">
            <TextBox x:Name="ChargeTextBox" VerticalContentAlignment="Center" HorizontalAlignment="Center" Height="22" TextWrapping="Wrap" Text="Charge fee..." VerticalAlignment="Center" Width="175" BorderBrush="Transparent" Foreground="Gray" GotFocus="ChargeTB_GotFocus" LostFocus="ChargeTB_LostFocus" FontSize="14">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="SelectionBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="Transparent"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
        </Border>
        <Border CornerRadius="5" BorderBrush="Gray" BorderThickness="1" HorizontalAlignment="Center" Height="30" Margin="0,65,0,0" VerticalAlignment="Top" Width="412">
            <TextBox x:Name="NameTextBox" VerticalContentAlignment="Center" HorizontalAlignment="Center" Height="23" TextWrapping="Wrap" Text="Name..." VerticalAlignment="Center" Width="404" BorderBrush="Transparent" Foreground="Gray" GotFocus="NameTB_GotFocus" LostFocus="NameTB_LostFocus" FontSize="14">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="SelectionBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="Transparent"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
        </Border>
        <Border CornerRadius="5" BorderBrush="Gray" BorderThickness="1" HorizontalAlignment="Left" Height="30" Margin="10,163,0,0" VerticalAlignment="Top" Width="408">
            <TextBox x:Name="AddressTextBox" VerticalContentAlignment="Center" HorizontalAlignment="Center" Height="23" TextWrapping="Wrap" Text="Address..." VerticalAlignment="Center" Width="398" BorderBrush="Transparent" Foreground="Gray" GotFocus="AddressTB_GotFocus" LostFocus="AddressTB_LostFocus" FontSize="14">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="SelectionBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="Transparent"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
        </Border>
        <Border CornerRadius="5" BorderBrush="Gray" BorderThickness="1" HorizontalAlignment="Left" Height="30" Margin="230,219,0,0" VerticalAlignment="Top" Width="185">
            <TextBox x:Name="PriceTextBox" VerticalContentAlignment="Center" HorizontalAlignment="Center" Height="22" TextWrapping="Wrap" Text="Price..." VerticalAlignment="Center" Width="175" BorderBrush="Transparent" Foreground="Gray" GotFocus="PriceTB_GotFocus" LostFocus="PriceTB_LostFocus" FontSize="14">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="SelectionBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="Transparent"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
        </Border>
        <Border CornerRadius="5" BorderBrush="Gray" BorderThickness="1" HorizontalAlignment="Left" Height="30" Margin="230,330,0,0" VerticalAlignment="Top" Width="182">
            <TextBox x:Name="DeliveryManTextBox" VerticalContentAlignment="Center" HorizontalAlignment="Center" Height="22" TextWrapping="Wrap" Text="Delivery Man..." VerticalAlignment="Center" Width="175" BorderBrush="Transparent" Foreground="Gray" GotFocus="DeliveryManTB_GotFocus" LostFocus="DeliveryManTB_LostFocus" FontSize="14">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="SelectionBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="Transparent"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
        </Border>

    </Grid>
</Window>
