<Window x:Class="SmartPoultry.Add_Delivery"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartPoultry"
        mc:Ignorable="d"
        Title="Add_Delivery" Height="480" Width="432" WindowStartupLocation="CenterScreen" Background="Transparent" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True">
    <Grid>
        <Border CornerRadius="10" BorderBrush="#FF2C6E5D" Background="White" BorderThickness="1">
            <Border CornerRadius="10 10 0 0" BorderBrush="#FF2C6E5D" BorderThickness="1" HorizontalAlignment="Center" Height="38" Margin="0,-1,0,0" VerticalAlignment="Top" Width="432" Background="#FF2C6E5D">
                <Button Click="Close_Click" HorizontalAlignment="Left" Height="27" Margin="394,0,0,0" VerticalAlignment="Center" Width="31" Background="#FF2C6E5D" BorderBrush="#FF2C6E5D">
                    <Image Height="24" Width="19" Source="/close.png"/>
                </Button>
            </Border>
        </Border>
        <Label HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Content="ADD DELIVERY" HorizontalAlignment="Center" Height="35" VerticalAlignment="Top" Width="220" FontSize="20" Foreground="White" FontWeight="Bold"/>
        <Border CornerRadius="0 0 10 10" BorderBrush="#FF2C6E5D" BorderThickness="1" HorizontalAlignment="Center" Height="32" Margin="0,448,0,0" VerticalAlignment="Top" Width="432" Background="#FF2C6E5D">
            <Button Content="CONFIRM" HorizontalAlignment="Center" Height="27" VerticalAlignment="Center" Width="412" BorderBrush="#FF2C6E5D" Background="#FF2C6E5D" FontSize="15" Click="ConfirmButton_Click" Foreground="White" FontWeight="Bold"/>
        </Border>
        <TextBox x:Name="NameTextBox" VerticalContentAlignment="Center" HorizontalAlignment="Left" Height="25" Margin="8,68,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="412"/>
        <Label Content="Name: " HorizontalAlignment="Left" Height="30" Margin="8,45,0,0" VerticalAlignment="Top" Width="96"/>
        <Label Content="Address:" HorizontalAlignment="Left" Height="26" Margin="8,142,0,0" VerticalAlignment="Top" Width="83"/>
        <TextBox x:Name="AddressTextBox" VerticalContentAlignment="Center" HorizontalAlignment="Left" Height="23" Margin="8,168,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="412"/>
        <Label Content="Type:" HorizontalAlignment="Left" Height="30" Margin="16,196,0,0" VerticalAlignment="Top" Width="96"/>
        <RadioButton x:Name="toDeliverRadio" Checked="ToDeliver_IsChecked"  IsChecked="True" GroupName="Type" VerticalContentAlignment="Center" Content="To Deliver" HorizontalAlignment="Left" Height="21" Margin="16,226,0,0" VerticalAlignment="Top" Width="90"/>
        <RadioButton x:Name="toReceiveRadio" Checked="ToReceive_IsChecked"  GroupName="Type" VerticalContentAlignment="Center" Content="To Receive" HorizontalAlignment="Left" Height="21" Margin="111,226,0,0" VerticalAlignment="Top" Width="90"/>
        <Label Content="Delivery Date: " HorizontalAlignment="Left" Height="30" Margin="10,313,0,0" VerticalAlignment="Top" Width="96"/>
        <DatePicker x:Name="datePicker" VerticalContentAlignment="Center" HorizontalAlignment="Left" Height="25" Margin="10,348,0,0" VerticalAlignment="Top" Width="189" Loaded="DatePicker_Loaded"/>
        <Label Content="Payment Mode:" HorizontalAlignment="Left" Height="30" Margin="8,252,0,0" VerticalAlignment="Top" Width="96"/>
        <RadioButton x:Name="CashRadio" Checked="CashRadio_IsChecked"  IsChecked="True" GroupName="Mode"  VerticalContentAlignment="Center" Content="Cash" HorizontalAlignment="Left" Height="21" Margin="13,287,0,0" VerticalAlignment="Top" Width="90"/>
        <RadioButton x:Name="GcashRadio" Checked="GCashRadio_IsChecked"  GroupName="Mode" VerticalContentAlignment="Center" Content="GCash" HorizontalAlignment="Left" Height="21" Margin="109,287,0,0" VerticalAlignment="Top" Width="90"/>
        <Label Content="Contacts:" HorizontalAlignment="Left" Height="30" Margin="10,378,0,0" VerticalAlignment="Top" Width="96" RenderTransformOrigin="0.515,1.038"/>
        <TextBox x:Name="ContactsTextBox" VerticalContentAlignment="Center" HorizontalAlignment="Left" Height="30" Margin="8,413,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="412"/>
        <Label Content="Order ID: " HorizontalAlignment="Left" Height="30" Margin="8,93,0,0" VerticalAlignment="Top" Width="96"/>
        <TextBox x:Name="OrderIdTextBox" VerticalContentAlignment="Center" HorizontalAlignment="Left" Height="25" Margin="8,117,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="412"/>
        <Label Content="Price:" HorizontalAlignment="Left" Height="30" Margin="230,196,0,0" VerticalAlignment="Top" Width="96" RenderTransformOrigin="0.515,1.038"/>
        <TextBox x:Name="PriceTextBox" VerticalContentAlignment="Center" HorizontalAlignment="Left" Height="23" Margin="230,225,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="190"/>
        <Label Content="Status: " HorizontalAlignment="Left" Height="30" Margin="230,254,0,0" VerticalAlignment="Top" Width="96"/>
        <RadioButton x:Name="PaidRadio" Checked="PaidRadio_IsChecked"  IsChecked="True" GroupName="Status"  VerticalContentAlignment="Center" Content="Paid" HorizontalAlignment="Left" Height="21" Margin="230,283,0,0" VerticalAlignment="Top" Width="90"/>
        <RadioButton x:Name="UnpaidRadio" Checked="UnpaidRadio_IsChecked"   GroupName="Status"  VerticalContentAlignment="Center" Content="Unpaid" HorizontalAlignment="Left" Height="21" Margin="320,284,0,0" VerticalAlignment="Top" Width="90"/>
        <Label Content="Delivery Man: " HorizontalAlignment="Left" Height="30" Margin="230,309,0,0" VerticalAlignment="Top" Width="96"/>
        <TextBox x:Name="DeliveryManTextBox" VerticalContentAlignment="Center" HorizontalAlignment="Left" Height="22" Margin="230,338,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="190"/>
        <Label Content="Charge: " HorizontalAlignment="Left" Height="24" Margin="230,360,0,0" VerticalAlignment="Top" Width="96"/>
        <TextBox x:Name="ChargeTextBox" VerticalContentAlignment="Center" HorizontalAlignment="Left" Height="22" Margin="230,386,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="190"/>

    </Grid>
</Window>
