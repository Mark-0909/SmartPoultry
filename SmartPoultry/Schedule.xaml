<UserControl x:Class="SmartPoultry.Schedule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SmartPoultry"
             mc:Ignorable="d" Width="599" Height="828" Background="#FFE3E3E3">
    <Grid>
        <Label Content="                        Schedule Payment" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="30" Width="641" Background="#FF2C6E5D" Foreground="White"/>
        <Label Content="Name:" HorizontalAlignment="Left" Height="43" Margin="27,79,0,0" VerticalAlignment="Top" Width="228" FontSize="24"/>
        <Label Content="Amount:" HorizontalAlignment="Left" Height="43" Margin="28,187,0,0" VerticalAlignment="Top" Width="228" FontSize="24"/>
        <Label Content="Contact Number:" HorizontalAlignment="Left" Height="43" Margin="31,290,0,0" VerticalAlignment="Top" Width="263" FontSize="24"/>
        <Label Content="Due Date:" HorizontalAlignment="Left" Height="42" Margin="31,397,0,0" VerticalAlignment="Top" Width="228" FontSize="24" RenderTransformOrigin="0.542,1.875"/>
        <Label Content="Type:" HorizontalAlignment="Left" Height="42" Margin="31,514,0,0" VerticalAlignment="Top" Width="228" FontSize="24"/>
        <Label Content="Mode of Payment:" HorizontalAlignment="Left" Height="44" Margin="31,635,0,0" VerticalAlignment="Top" Width="289" FontSize="24"/>
        <Button Content="Confirm" HorizontalAlignment="Center" Height="55" Margin="0,774,0,0" VerticalAlignment="Top" Width="598" Background="#FF2C6E5D" Foreground="White" Click="Button_Click" FontSize="30"/>
        <TextBox HorizontalAlignment="Left" Height="49" Margin="31,127,0,0" TextWrapping="Wrap" Text="Type here..." VerticalAlignment="Top" Width="540" FontSize="20" Foreground="Gray" VerticalContentAlignment="Center" BorderThickness="0,0,0,0" HorizontalScrollBarVisibility="Auto"/>
        <TextBox HorizontalAlignment="Left" Height="50" Margin="31,230,0,0" TextWrapping="Wrap" Text="0" VerticalAlignment="Top" Width="273" Foreground="Gray" FontSize="20" VerticalContentAlignment="Center"/>
        <TextBox HorizontalAlignment="Left" Height="50" Margin="33,335,0,0" TextWrapping="Wrap" Text="Type here..." VerticalAlignment="Top" Width="273" Foreground="Gray" FontSize="20" VerticalContentAlignment="Center"/>
        <DatePicker HorizontalAlignment="Left" Height="45" Margin="31,450,0,0" VerticalAlignment="Top" Width="273" FontSize="28" Foreground="Gray"/>
        <ComboBox HorizontalAlignment="Left" Height="55" Margin="33,561,0,0" VerticalAlignment="Top" Width="165" Text="Select"/>
        <ComboBox HorizontalAlignment="Left" Height="59" Margin="33,684,0,0" VerticalAlignment="Top" Width="165"/>

    </Grid>
</UserControl>
