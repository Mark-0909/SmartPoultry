<UserControl x:Class="SmartPoultry.Organization_UserLogs"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SmartPoultry"
             mc:Ignorable="d" 
             d:DesignHeight="61" d:DesignWidth="424" Width="423" Height="61" Margin="0 0 0 5">
    <Grid>
        <Border x:Name="ControlBorder" CornerRadius="10" BorderBrush="#FFDBDBDB" BorderThickness="1" HorizontalAlignment="Center" Height="61" VerticalAlignment="Center" Width="424" Background="#FFDBDBDB">
            <WrapPanel>
                <Label x:Name="DateLabel"  HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Content="Date" Height="59" Width="211"/>
                <Label x:Name="ActionLabel" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Content="Action" Height="59" Width="211"/>
            </WrapPanel>
        </Border>


    </Grid>
</UserControl>
