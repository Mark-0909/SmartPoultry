<Window x:Class="SmartPoultry.Add_FinancialLiabilities"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartPoultry"
        mc:Ignorable="d"
        Title="Add_FinancialLiabilities" Height="480" Width="432" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" WindowStyle="None" Background="Transparent" AllowsTransparency="True">
    <Window.Resources>
        <Style x:Key="NoHoverButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <!-- Animation for the button itself when hovered -->
                                            <DoubleAnimation 
                                            Storyboard.TargetProperty="Opacity" 
                                            To=".7" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>

                                            <DoubleAnimation 
                                            Storyboard.TargetProperty="Opacity" 
                                            To="1.0" Duration="0:0:0.3" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Border x:Name="Overlay" BorderBrush="#FFA7A7A7" Background="#FFA7A7A7" CornerRadius="10" Opacity=".5" BorderThickness="1" HorizontalAlignment="Center" Height="480" VerticalAlignment="Center" Width="432"/>

        <Border CornerRadius="10" BorderBrush="#FF2C6E5D" Background="White" BorderThickness="1">
            <Border CornerRadius="10 10 0 0" BorderBrush="#FF2C6E5D" BorderThickness="1" HorizontalAlignment="Center" Height="38" Margin="0,-1,0,0" VerticalAlignment="Top" Width="432" Background="#FF2C6E5D">
                <Button Click="Close_Click" HorizontalAlignment="Left" Height="27" Margin="394,0,0,0" VerticalAlignment="Center" Width="31" Background="#FF2C6E5D" BorderBrush="#FF2C6E5D"  Style="{StaticResource NoHoverButton}">
                    <Image Height="24" Width="19" Source="/Images/close.png"/>
                </Button>
            </Border>
        </Border>
        <Label HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Content="SCHEDULE PAYMENT" HorizontalAlignment="Center" Height="35" VerticalAlignment="Top" Width="220" FontSize="20" Foreground="White" FontWeight="Bold"/>
        <Border CornerRadius="0 0 10 10" BorderBrush="#FF2C6E5D" BorderThickness="1" HorizontalAlignment="Center" Height="32" Margin="0,448,0,0" VerticalAlignment="Top" Width="432" Background="#FF2C6E5D">
            <Button x:Name="ConfirmBtn"  Content="CONFIRM" HorizontalAlignment="Center" Height="27" VerticalAlignment="Center" Width="412" BorderBrush="#FF2C6E5D" Background="#FF2C6E5D" FontSize="15" Click="ConfirmButton_Click" Foreground="White" FontWeight="Bold"  Style="{StaticResource NoHoverButton}"/>
        </Border>
        <Label Content="Name: " HorizontalAlignment="Left" Height="30" Margin="12,43,0,0" VerticalAlignment="Top" Width="96" FontSize="14"/>
        <Label Content="Price: " HorizontalAlignment="Left" Height="30" Margin="13,106,0,0" VerticalAlignment="Top" Width="96" FontSize="14"/>
        <Label Content="Type:" HorizontalAlignment="Left" Height="30" Margin="10,176,0,0" VerticalAlignment="Top" Width="96" FontSize="14"/>
        <RadioButton x:Name="ToPayRBtn" Checked="ToPay_IsChecked" IsChecked="True" GroupName="Type" VerticalContentAlignment="Center" Content="To Pay" HorizontalAlignment="Left" Height="21" Margin="10,206,0,0" VerticalAlignment="Top" Width="90" FontSize="14"/>
        <RadioButton x:Name="ToReceiveRBtn" Checked="ToReceive_IsChecked" GroupName="Type" VerticalContentAlignment="Center" Content="To Receive" HorizontalAlignment="Left" Height="21" Margin="100,206,0,0" VerticalAlignment="Top" Width="90" FontSize="14"/>
        <Label Content="Due Date: " HorizontalAlignment="Left" Height="30" Margin="216,176,0,0" VerticalAlignment="Top" Width="96" FontSize="14"/>
        <Label Content="Payment Mode:" HorizontalAlignment="Left" Height="30" Margin="13,232,0,0" VerticalAlignment="Top" Width="112" FontSize="14"/>
        <RadioButton x:Name="CashRBtn" Checked="Cash_IsChecked" IsChecked="True" GroupName="Mode"  VerticalContentAlignment="Center" Content="Cash" HorizontalAlignment="Left" Height="22" Margin="13,267,0,0" VerticalAlignment="Top" Width="90" FontSize="14"/>
        <RadioButton x:Name="GCashRBtn" Checked="GCash_IsChecked" GroupName="Mode" VerticalContentAlignment="Center" Content="GCash" HorizontalAlignment="Left" Height="22" Margin="114,262,0,0" VerticalAlignment="Top" Width="90" FontSize="14"/>
        <Label Content="Contacts:" HorizontalAlignment="Left" Height="30" Margin="13,294,0,0" VerticalAlignment="Top" Width="96" FontSize="14"/>
        <Border CornerRadius="5" BorderBrush="Gray" BorderThickness="1" HorizontalAlignment="Left" Height="30" Margin="13,329,0,0" VerticalAlignment="Top" Width="412">
            <TextBox x:Name="ContactsTextBox" VerticalContentAlignment="Center" HorizontalAlignment="Center" Height="22" TextWrapping="Wrap" Text="Contacts..." VerticalAlignment="Bottom" Width="404" GotFocus="ContactTB_GotFocus" LostFocus="ContactTB_LostFocus" Foreground="Gray" BorderBrush="Transparent" FontSize="14" Margin="0,0,0,3" TextChanged="ContactsTextBox_TextChanged">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="SelectionBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="Transparent"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>

            </TextBox>
        </Border>
        <Border CornerRadius="5" BorderBrush="Gray" BorderThickness="1" HorizontalAlignment="Left" Height="30" Margin="13,141,0,0" VerticalAlignment="Top" Width="412">
            <TextBox x:Name="PriceTextBox" VerticalContentAlignment="Center" HorizontalAlignment="Center" Height="23" TextWrapping="Wrap" Text="Price..." VerticalAlignment="Center" Width="404" GotFocus="PriceTB_GotFocus" LostFocus="PriceTB_LostFocus" Foreground="Gray" BorderBrush="Transparent" FontSize="14" TextChanged="PriceTextBox_TextChanged">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="SelectionBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="Transparent"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>

            </TextBox>
        </Border>
        <Border CornerRadius="5" BorderBrush="Gray" BorderThickness="1" HorizontalAlignment="Left" Height="30" Margin="13,71,0,0" VerticalAlignment="Top" Width="412">
            <TextBox x:Name="NameTextBox" VerticalContentAlignment="Center" HorizontalAlignment="Center" Height="22" TextWrapping="Wrap" Text="Name..." VerticalAlignment="Center" Width="404" GotFocus="NameTB_GotFocus" LostFocus="NameTB_LostFocus" Foreground="Gray" Background="Transparent" BorderBrush="Transparent" FontSize="14">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="SelectionBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="Transparent"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>

            </TextBox>
        </Border>
        <Border CornerRadius="5" BorderBrush="Gray" BorderThickness="1" HorizontalAlignment="Left" Height="30" Margin="216,202,0,0" VerticalAlignment="Top" Width="204">
            <DatePicker x:Name="datePicker" VerticalContentAlignment="Center" HorizontalAlignment="Left" Height="30" VerticalAlignment="Center" Width="199" Loaded="DatePicker_Loaded" Margin="4,0,0,0" BorderBrush="Transparent" FontSize="14" Foreground="Gray">
                <DatePicker.Style>
                    <Style TargetType="DatePicker">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="Transparent"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DatePicker.Style>
            </DatePicker>
        </Border>
        <Button x:Name="EditBtn" Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Left" Height="38" Margin="345,407,0,0" VerticalAlignment="Top" Width="44" Click="EditBtn_Click"  Style="{StaticResource NoHoverButton}">
            <Image Height="38" Width="39" Source="/Images/editIcon.png"/>
        </Button>
        <Label x:Name="orderIdLabel" Content="Order ID:" HorizontalAlignment="Left" Height="30" Margin="10,410,0,0" VerticalAlignment="Top" Width="80" FontSize="14"/>
        <Label x:Name="OrderId" Content="25010838347" HorizontalAlignment="Left" Height="30" Margin="90,410,0,0" VerticalAlignment="Top" Width="100" FontSize="14"/>
        <Button x:Name="OrderDetailsBtn" HorizontalAlignment="Left" Height="30" Margin="190,410,0,0" VerticalAlignment="Top" Width="35" Click="OrderDetailsBtn_Click"  Style="{StaticResource NoHoverButton}">
            <Image Height="22" Width="24" Source="/Images/infoicon.png"/>
        </Button>


        <Border x:Name="NotifPopup"  CornerRadius="10" BorderBrush="#FFCCE6D3" BorderThickness="1" HorizontalAlignment="Center" Height="46" Margin="0,24,0,0" VerticalAlignment="Top" Width="330" Background="#FFCCE6D3">
            <WrapPanel>
                <Label x:Name="NotifMessage"  Content="Invalid Credentials" VerticalContentAlignment="Center" Padding="20 0 0 0" Height="43" Width="302" Foreground="#FF666666"/>
                <Button x:Name="NotifCloseBtn" BorderBrush="Transparent" Background="Transparent" Height="20" Width="21" Click="NotifCloseBtn_Click"  Style="{StaticResource NoHoverButton}">
                    <Image Height="16" Width="10" Source="/Images/closegray.png"/>
                </Button>
            </WrapPanel>
        </Border>
        <Button 
HorizontalAlignment="Left" 
Height="39" 
Margin="391,405,0,0" 
VerticalAlignment="Top" 
Width="33" 
MouseEnter="Button_MouseEnter"
MouseLeave="Button_MouseLeave" Style="{StaticResource NoHoverButton}" Click="Button_Click">
            <Image x:Name="RemarksBtn" Height="30" Width="29" Source="/Images/remarksIcon.png"/>
        </Button>

        <TextBox x:Name="RemarksTextBox" 
 HorizontalAlignment="Left" 
 VerticalAlignment="Top" 
 Margin="165,360,0,0" 
 Width="200" 
 Height="50" 
 IsReadOnly="True" 
 Visibility="Collapsed" 
 Background="LightYellow" 
 BorderBrush="Goldenrod" 
 BorderThickness="2" 
 FontSize="14"
 VerticalContentAlignment="Center"
 Padding="5"
 Panel.ZIndex="100">
            <TextBox.Effect>
                <DropShadowEffect Color="Gray" Direction="315" ShadowDepth="2" BlurRadius="5" />
            </TextBox.Effect>
        </TextBox>
    </Grid>
</Window>
