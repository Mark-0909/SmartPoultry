<UserControl x:Class="SmartPoultry.Inventory_OrderSupplyControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SmartPoultry"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="200"
             Width="Auto" Height="Auto">
    <Grid>
        <!-- Main Content -->
        <Border BorderBrush="Black" BorderThickness="1" Background="#FFEAEAEA">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <WrapPanel x:Name="Wpanel" Margin="0" Width="Auto" HorizontalAlignment="Stretch">
                    <!-- Supplier Info Section -->
                    <Border BorderBrush="Transparent" BorderThickness="1" Background="Transparent">
                        <Label Content="Supplier:" Height="33" Width="89"/>
                    </Border>
                    <Border BorderBrush="Transparent" BorderThickness="1" Background="Transparent">
                        <Label x:Name="SupplierNameLabel" Content="Supplier Name" Height="33" Width="267"/>
                    </Border>

                    <Border BorderBrush="Transparent" BorderThickness="1" Background="Transparent">
                        <Label Content="Contact Person:" Height="33" Width="105"/>
                    </Border>
                    <Border BorderBrush="Transparent" BorderThickness="1" Background="Transparent">
                        <Label x:Name="ContactPersonLabel" Content="Contact Person" Height="33" Width="229"/>
                    </Border>
                    <Border BorderBrush="Transparent" BorderThickness="1" Background="Transparent">
                        <Label Content="Contact: " Height="33" Width="92"/>
                    </Border>
                    <Border BorderBrush="Transparent" BorderThickness="1" Background="Transparent" Width="244">
                        <Label x:Name="ContactLabel" Content="Contact" Height="33" Width="92"/>
                    </Border>
                    <Border BorderBrush="Transparent" BorderThickness="1" Background="Transparent" Width="93">
                        <Label x:Name="ContactLabel1_Copy" Content="Delivery Date: " Height="33" Width="92" Margin="0,0,-1,0"/>
                    </Border>
                    <Border BorderBrush="Transparent" BorderThickness="1" Background="Transparent" Width="93">
                        <DatePicker x:Name="datePicker" Loaded="DatePicker_Loaded"/>

                    </Border>

                    <!-- Product Info Header -->
                    <Border BorderBrush="Transparent" BorderThickness="1" Background="Transparent" Width="370" Height="46">
                        <WrapPanel>
                            <Label Content="Product" Height="34" Width="77"/>
                            <Label Content="Current Stocks" Height="34" Width="96"/>
                            <Label Content="QTY" Height="34" Width="77"/>
                        </WrapPanel>
                    </Border>
                </WrapPanel>
            </ScrollViewer>
        </Border>

        <!-- Remove Button Positioned in the Upper Right -->
        <Button Content="Remove"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="5"
            Width="75"
            Height="30"
            Background="Red"
            Foreground="White"
            FontWeight="Bold"
            Click="Remove_Clicked"/>
    </Grid>

</UserControl>
