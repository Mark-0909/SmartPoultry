<UserControl x:Class="SmartPoultry.Inventory_OrderSupplyControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SmartPoultry"
             mc:Ignorable="d" d:DesignWidth="382" Width="382" Height="207">
    <Grid>
        <Border BorderBrush="Black" BorderThickness="1" Background="#FFEAEAEA">
            <WrapPanel>

                <Border BorderBrush="Transparent" BorderThickness="1" Background="Transparent" >
                    <Label Content="Supplier:" Height="33" Width="89"/>
                </Border>
                <Border BorderBrush="Transparent" BorderThickness="1" Background="Transparent" >
                    <Label Content="Label" Height="33" Width="267"/>
                </Border>


                <Border BorderBrush="Transparent" BorderThickness="1" Background="Transparent" >
                    <Label Content="Contact Person:" Height="33" Width="105"/>
                </Border>
                <Border BorderBrush="Transparent" BorderThickness="1" Background="Transparent" >
                    <Label Content="Label" Height="33" Width="229"/>
                </Border>
                <Border BorderBrush="Transparent" BorderThickness="1" Background="Transparent" Width="98" >
                    <Label Content="Contact: " Height="33" Width="92"/>
                </Border>
                <Border BorderBrush="Transparent" BorderThickness="1" Background="Transparent" Width="101" >
                    <Label Content="Label" Height="33" Width="92"/>
                </Border>
                <Border BorderBrush="Transparent" BorderThickness="1" Background="Transparent" Width="370" Height="46" >
                    <WrapPanel>
                        <Label Content="Product" Height="34" Width="77"/>
                        <Label Content="Current Stocks" Height="34" Width="96"/>
                        <Label Content="QTY" Height="34" Width="77"/>
                    </WrapPanel>
                </Border>


                <Border BorderBrush="White" BorderThickness="1" Background="White" Width="370" Height="44">
                    <WrapPanel>
                        <Label Content="name" Height="32" Width="143"/>
                        <Label Content="Stcks" Height="32" Width="71"/>
                        <Button Height="26" Width="30" BorderBrush="Transparent" Background="Transparent">
                            <Image Height="20" Width="23" Source="/Images/minusorder.png"/>
                        </Button>
                        <Label Content="1" Height="32" Width="15" />
                        <Button Height="26" Width="30" BorderBrush="Transparent" Background="Transparent">
                            <Image Height="22" Width="24" Source="/Images/addorder.png"/>
                        </Button>
                        <Button Height="26" Width="30" BorderBrush="Transparent" Background="Transparent">
                            <Image Height="20" Width="25" Source="/Images/removeorder.png"/>
                        </Button>
                    </WrapPanel>
                </Border>
            </WrapPanel>
        </Border>


    </Grid>
</UserControl>
