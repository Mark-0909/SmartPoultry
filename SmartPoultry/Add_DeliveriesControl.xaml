<UserControl x:Class="SmartPoultry.Add_DeliveriesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SmartPoultry"
             mc:Ignorable="d" 
             d:DesignHeight="40" d:DesignWidth="341" Width="341" Height="40" Background="Transparent" Margin="0 0 0 5">
    <Grid>
        <Border x:Name="thisBorder" CornerRadius="5" BorderBrush="#FFDBDBDB" BorderThickness="1" Background="#FFDBDBDB">
            <Button HorizontalAlignment="Left" Height="29" Margin="299,0,0,0" VerticalAlignment="Center" Width="31" BorderBrush="Transparent" Background="Transparent" Click="DisplayDetail_Clicked">
                <Image Height="23.5" Width="22" Source="/Images/infoicon.png"/>
            </Button>
        </Border>
        <Label x:Name="NameLabel" VerticalContentAlignment="Center" Content="Label" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Height="32" Margin="10,0,0,0" VerticalAlignment="Center" Width="93"/>
        <Label x:Name="Datelabel" VerticalContentAlignment="Center" Content="Label" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Height="31" Margin="108,0,0,0" VerticalAlignment="Center" Width="93"/>
        <Label x:Name="StatusLabel" VerticalContentAlignment="Center" Content="Label" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Height="31" Margin="201,0,0,0" VerticalAlignment="Center" Width="93"/>

    </Grid>
</UserControl>
