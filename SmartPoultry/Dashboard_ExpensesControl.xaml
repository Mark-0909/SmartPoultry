<UserControl x:Name="thisBorder" x:Class="SmartPoultry.Dashboard_ExpensesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SmartPoultry"
             mc:Ignorable="d" 
             d:DesignHeight="40" d:DesignWidth="341" Width="330" Height="35" Background="Transparent" Margin="5 0 0 5">
    <UserControl.Resources>
        <Style x:Key="NoHoverButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <!-- Animation for the button itself when hovered -->
                                            <DoubleAnimation 
                                            Storyboard.TargetProperty="Opacity" 
                                            To=".7" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>

                                            <DoubleAnimation 
                                            Storyboard.TargetProperty="Opacity" 
                                            To="1.0" Duration="0:0:0.3" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border x:Name="thisBorder1" CornerRadius="5" BorderBrush="#FFF8F8F8" BorderThickness="1" Background="#FFDBDBDB">
            <Button HorizontalAlignment="Left" Height="29" Margin="295,0,0,0" VerticalAlignment="Center" Width="31" BorderBrush="Transparent" Background="Transparent" Click="Info_Clicked"  Style="{StaticResource NoHoverButton}"
 >
                <Image Height="23" Width="22" Source="/Images/infoicon.png"/>
            </Button>
        </Border>
        <Label x:Name="Namelabel" HorizontalContentAlignment="Center" Content="Label" HorizontalAlignment="Left" Height="26" Margin="5,0,0,0" VerticalAlignment="Center" Width="100"/>
        <Label x:Name="DueDateLabel" Content="Label" HorizontalAlignment="Left" Height="26" VerticalAlignment="Center" Width="70" Margin="120,0,0,0"/>
        <Label x:Name="AmountLabel" Content="Label" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Height="26" Margin="215,0,0,0" VerticalAlignment="Center" Width="70"/>

    </Grid>
</UserControl>
