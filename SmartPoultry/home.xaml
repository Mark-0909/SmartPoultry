        <Label Content="Total:" HorizontalAlignment="Left" Margin="787,497,0,0" VerticalAlignment="Top" FontSize="15" FontWeight="Bold"/>
        <Label x:Name="totalPiceLabel"  Content="0" HorizontalAlignment="Left" Margin="1000,498,0,0" VerticalAlignment="Top" HorizontalContentAlignment="Right" Width="100" FontSize="15" FontWeight="Bold"/>
    </Grid>
</UserControl>
