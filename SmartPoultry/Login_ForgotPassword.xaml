<UserControl x:Class="SmartPoultry.Login_ForgotPassword"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SmartPoultry"
             mc:Ignorable="d" Width="390" Height="480">
    <UserControl.Resources>
        <Style x:Key="NoHoverButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}" 
                        BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <!-- Animation for the button itself when hovered -->
                                            <DoubleAnimation 
                                        Storyboard.TargetProperty="Opacity" 
                                        To=".7" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>

                                            <DoubleAnimation 
                                        Storyboard.TargetProperty="Opacity" 
                                        To="1.0" Duration="0:0:0.3" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Border  BorderBrush="White" BorderThickness="1" HorizontalAlignment="Center" Height="480" VerticalAlignment="Center" Width="390" Background="White">
            <Rectangle HorizontalAlignment="Left" Height="3" Stroke="#FF7BC977" VerticalAlignment="Top" Width="159" Fill="#FF7BC977" Margin="48,60,0,0"/>
        </Border>

        <Button Content="Login" HorizontalAlignment="Center" Height="24" Margin="0,445,0,0" VerticalAlignment="Top" Width="44" Background="Transparent" BorderBrush="Transparent" Click="ChangeControl_Click" FontWeight="Bold" Foreground="#FF5C5C60" Style="{StaticResource NoHoverButton}"/>
        <Label Content="Username: " HorizontalAlignment="Left" Height="26" Margin="32,80,0,0" VerticalAlignment="Top" Width="132" FontSize="15" Foreground="#FF5C5C5C"/>
        <Label x:Name="QuestionLabel" Content="Question: " HorizontalAlignment="Left" Height="26" Margin="34,149,0,0" VerticalAlignment="Top" Width="144" FontSize="15" Foreground="#FF5C5C5C"/>
        <Button Click="Verify_Clicked" x:Name="VerifyBtn" Content="Verify" HorizontalAlignment="Left" HorizontalContentAlignment="Right" Height="22" VerticalAlignment="Top" Width="81" FontWeight="Bold" Margin="277,218,0,0" Background="Transparent" BorderBrush="Transparent" Foreground="#FF5C5C60" Style="{StaticResource NoHoverButton}"/>
        <Label
        Width="346" VerticalAlignment="Top" VerticalContentAlignment="Center" Margin="34,10,0,0" HorizontalContentAlignment="Left" Height="51" HorizontalAlignment="Left" FontSize="30" FontWeight="Bold" Content="Forgot Password" Foreground="Black"/>
        <Border CornerRadius="5                 " BorderBrush="DarkGray" BorderThickness="1" HorizontalAlignment="Center" Height="33" Margin="0,111,0,0" VerticalAlignment="Top" Width="326" Background="White">
            <TextBox x:Name="usernameTB" VerticalContentAlignment="Center" HorizontalAlignment="Center" Height="25" TextWrapping="Wrap" Text="Username..." VerticalAlignment="Center" Width="306" Padding="1" Background="Transparent" BorderBrush="Transparent" FontSize="14" GotFocus="UsernameTB_GotFocused" LostFocus="UsernameTB_LostFocused" Foreground="Gray">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="SelectionBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="Transparent"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
        </Border>
        <Border CornerRadius="5                 " BorderBrush="DarkGray" BorderThickness="1" HorizontalAlignment="Center" Height="33" Margin="0,180,0,0" VerticalAlignment="Top" Width="326" Background="White">
            <TextBox x:Name="QuestionTB"  VerticalContentAlignment="Center" HorizontalAlignment="Center" Height="25" TextWrapping="Wrap" Text="Your answer..." VerticalAlignment="Center" Width="306" Padding="1" Background="Transparent" BorderBrush="Transparent" FontSize="14" GotFocus="QuestionTB_GotFocused" LostFocus="QuestionTB_LostFocused" Foreground="Gray">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="SelectionBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="Transparent"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
        </Border>

        <Border CornerRadius="5                 " BorderBrush="DarkGray" BorderThickness="1" HorizontalAlignment="Center" Height="33" Margin="0,276,0,0" VerticalAlignment="Top" Width="328" Background="White">
            <PasswordBox x:Name="createNewPassTB" IsEnabled="False" HorizontalAlignment="Left" Height="25" VerticalAlignment="Center" Width="312" Background="Transparent" BorderBrush="Transparent" VerticalContentAlignment="Center" Padding="1" Margin="9,0,0,0" LostFocus="CreateNewPass_LostFocused">
                <PasswordBox.Style>
                    <Style TargetType="PasswordBox">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="SelectionBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="Transparent"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </PasswordBox.Style>
            </PasswordBox>
        </Border>
        <Label Content="Create New Password: " HorizontalAlignment="Left" Height="31" Margin="34,240,0,0" VerticalAlignment="Top" Width="175" FontSize="15" Foreground="#FF5C5C5C"/>
        <Border CornerRadius="5                 " BorderBrush="DarkGray" BorderThickness="1" HorizontalAlignment="Center" Height="33" Margin="0,350,0,0" VerticalAlignment="Top" Width="328" Background="White">
            <PasswordBox x:Name="confirmNewPassTB" IsEnabled="False" HorizontalAlignment="Left" Height="25" VerticalAlignment="Center" Width="312" Background="Transparent" BorderBrush="Transparent" VerticalContentAlignment="Center" Padding="1" Margin="9,0,0,0" LostFocus="ConfirmNewPass_LostFocused">
                <PasswordBox.Style>
                    <Style TargetType="PasswordBox">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="SelectionBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="Transparent"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </PasswordBox.Style>
            </PasswordBox>
        </Border>
        <Label Content="Confirm New Password:" HorizontalAlignment="Left" Height="31" Margin="32,314,0,0" VerticalAlignment="Top" Width="175" FontSize="15" Foreground="#FF5C5C5C" RenderTransformOrigin="0.341,1.598"/>
        <TextBox x:Name="confirmNewPassOverTB" IsEnabled="False" VerticalContentAlignment="Center" HorizontalAlignment="Center" Height="25" TextWrapping="Wrap" Text="Confirm new password..." VerticalAlignment="Top" Width="308" Padding="1" Background="Transparent" BorderBrush="Transparent" FontSize="14" GotFocus="ConfirmOverTB_GotFocused"  Foreground="Gray" Margin="0,354,0,0">
            <TextBox.Style>
                <Style TargetType="TextBox">
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="SelectionBrush" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Style.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="Transparent"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TextBox.Style>
        </TextBox>
        <TextBox x:Name="CreateNewPassOverTB" IsEnabled="False" VerticalContentAlignment="Center" HorizontalAlignment="Center" Height="25" TextWrapping="Wrap" Text="New password..." VerticalAlignment="Top" Width="308" Padding="1" Background="Transparent" BorderBrush="Transparent" FontSize="14" GotFocus="CreateOverTB_GotFocused" Foreground="Gray" Margin="0,280,0,0">
            <TextBox.Style>
                <Style TargetType="TextBox">
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="SelectionBrush" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Style.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="Transparent"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TextBox.Style>
        </TextBox>
        <Button x:Name="ChangePassBtn"  IsEnabled="False" Content="CONFIRM" HorizontalAlignment="Center" Height="35" Margin="0,407,0,0" VerticalAlignment="Top" Width="328" FontWeight="Bold" Click="Submit_Clicked" Background="#FF7BCA77" BorderBrush="#FF7BC877" Foreground="White" Style="{StaticResource NoHoverButton}"/>
    </Grid>
</UserControl>
