<UserControl x:Class="SmartPoultry.Login_ForgotPassword"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SmartPoultry"
             mc:Ignorable="d" Width="390" Height="480">
    <Grid>
        <Border CornerRadius="10" BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Center" Height="480" VerticalAlignment="Center" Width="390" Background="#FF9AB989"/>
        <Button x:Name="ChangePassBtn"  IsEnabled="False" Content="CONFIRM" HorizontalAlignment="Center" Height="35" Margin="0,391,0,0" VerticalAlignment="Top" Width="282" FontWeight="Bold" Click="Submit_Clicked"/>
        <Button Content="Login" HorizontalAlignment="Center" Height="24" Margin="0,426,0,0" VerticalAlignment="Top" Width="44" Background="Transparent" BorderBrush="Transparent" Click="ChangeControl_Click" FontWeight="Bold"/>
        <Label Content="Username: " HorizontalAlignment="Left" Height="26" Margin="54,80,0,0" VerticalAlignment="Top" Width="132" FontSize="15"/>
        <Label x:Name="QuestionLabel" Content="Question: " HorizontalAlignment="Left" Height="31" Margin="54,149,0,0" VerticalAlignment="Top" Width="144" FontSize="15"/>
        <Button Click="Verify_Clicked" x:Name="VerifyBtn" Content="Verify" HorizontalAlignment="Left" HorizontalContentAlignment="Right" Height="22" VerticalAlignment="Top" Width="81" FontWeight="Bold" Margin="255,218,0,0" Background="Transparent" BorderBrush="Transparent"/>
        <Label HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Content="Forgot Password" HorizontalAlignment="Center" Height="51" Margin="0,10,0,0" VerticalAlignment="Top" Width="390" FontSize="30" FontWeight="Bold"/>
        <Border CornerRadius="5                 " BorderBrush="DarkGray" BorderThickness="1" HorizontalAlignment="Center" Height="33" Margin="0,111,0,0" VerticalAlignment="Top" Width="282" Background="White">
            <TextBox x:Name="usernameTB" VerticalContentAlignment="Center" HorizontalAlignment="Center" Height="25" TextWrapping="Wrap" Text="Username..." VerticalAlignment="Center" Width="268" Padding="1" Background="Transparent" BorderBrush="Transparent" FontSize="14" GotFocus="UsernameTB_GotFocused" LostFocus="UsernameTB_LostFocused"/>
        </Border>
        <Border CornerRadius="5                 " BorderBrush="DarkGray" BorderThickness="1" HorizontalAlignment="Center" Height="33" Margin="0,180,0,0" VerticalAlignment="Top" Width="282" Background="White">
            <TextBox x:Name="QuestionTB"  VerticalContentAlignment="Center" HorizontalAlignment="Center" Height="25" TextWrapping="Wrap" Text="Your answer..." VerticalAlignment="Center" Width="268" Padding="1" Background="Transparent" BorderBrush="Transparent" FontSize="14" GotFocus="QuestionTB_GotFocused" LostFocus="QuestionTB_LostFocused"/>
        </Border>
        <Border CornerRadius="5                 " BorderBrush="DarkGray" BorderThickness="1" HorizontalAlignment="Center" Height="33" Margin="0,261,0,0" VerticalAlignment="Top" Width="282" Background="White">
            <PasswordBox x:Name="createNewPassTB" IsEnabled="False" HorizontalAlignment="Right" Height="25" VerticalAlignment="Center" Width="270" Background="Transparent" BorderBrush="Transparent" VerticalContentAlignment="Center" Padding="1" Margin="0,0,5,0"/>
        </Border>
        <Label Content="Create New Password: " HorizontalAlignment="Left" Height="31" Margin="54,230,0,0" VerticalAlignment="Top" Width="175" FontSize="15"/>
        <Border CornerRadius="5                 " BorderBrush="DarkGray" BorderThickness="1" HorizontalAlignment="Center" Height="33" Margin="0,325,0,0" VerticalAlignment="Top" Width="282" Background="White">
            <PasswordBox x:Name="confirmNewPassTB" IsEnabled="False" HorizontalAlignment="Right" Height="25" VerticalAlignment="Center" Width="270" Background="Transparent" BorderBrush="Transparent" VerticalContentAlignment="Center" Padding="1" Margin="0,0,5,0"/>
        </Border>
        <Label Content="Confirm New Password:" HorizontalAlignment="Left" Height="31" Margin="54,294,0,0" VerticalAlignment="Top" Width="175" FontSize="15"/>

    </Grid>
</UserControl>
