                </Button>
            </Border>
        </WrapPanel>
        <Label Content="Stocks: " HorizontalAlignment="Left" Margin="23,621,0,0" VerticalAlignment="Top" FontSize="15"/>
        <Label x:Name="stocklisting" Content="stocks " HorizontalAlignment="Left" Margin="113,621,0,0" VerticalAlignment="Top" FontSize="15"/>
        <Label x:Name="stockunit" Content="stocks " HorizontalAlignment="Left" Margin="203,621,0,0" VerticalAlignment="Top" FontSize="15"/>
