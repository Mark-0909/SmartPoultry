            <Button x:Name="typeVaccinesBtn" Click="VaccinesButton_Click" Content="Vaccines"  
                FontSize="15" Foreground="#FFB9B9B9" Background="White" BorderBrush="White" 
                Style="{StaticResource NoHoverButton}" Margin="9,4,9,4"/>
        </Border>

        <Border CornerRadius="10" BorderBrush="#FFDDDDDD" BorderThickness="1" Margin="225,189,20,462" Background="White" Height="42">
