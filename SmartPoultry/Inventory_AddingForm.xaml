<Window x:Class="SmartPoultry.Inventory_AddingForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartPoultry"
        mc:Ignorable="d"
        Title="Inventory_AddingForm" Height="721" Width="624" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="None" Background="Transparent" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="NoHoverButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation 
                                                Storyboard.TargetProperty="Opacity" 
                                                To=".7" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation 
                                                Storyboard.TargetProperty="Opacity" 
                                                To="1.0" Duration="0:0:0.3" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>

        <Border x:Name="AddingFormOverlay" Opacity=".5"  CornerRadius="10" BorderBrush="Transparent" Background="#FFA7A7A7" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" Height="721" Width="624"/>



        <Border CornerRadius="10" BorderBrush="#FF077C5E" BorderThickness="2" Background="#FFDDDDDD">
            <Border CornerRadius="10 10 0 0" BorderThickness="1" Margin="-2,-2,-2,680" Background="#FF2C6E5D" BorderBrush="#FF2C6E5D">
                <Button Margin="580,2,4,2" Click="CloseAddPopup_Click" Background="Transparent" BorderBrush="Transparent">
                    <Image Height="28" Width="36" Source="/Images/close.png"/>
                </Button>
            </Border>
        </Border>
        <Label x:Name="windowName" HorizontalContentAlignment="Center"  Content="ADD PRODUCT" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="25" Width="262" Height="41" Foreground="White" FontStretch="SemiExpanded" Margin="0,-5,0,0"/>
        <Border CornerRadius="10" BorderThickness="1" Margin="32,70,396,445" Background="White" BorderBrush="#FFD8D8D8">
            <Button  Style="{StaticResource NoHoverButton}" x:Name="SelectImageBtn" Click="SelectImage_Click" Margin="9,9,9,9" Background="White" BorderBrush="#FFE4E1E1">
                <Image x:Name="SelectedImage" Height="72" Width="70" Source="/Images/clipicon.png"/>
            </Button>
        </Border>

        <Border x:Name="animalChickenBorder" Height="39" Width="76" VerticalAlignment="Top" 
            Margin="32,316,0,0" HorizontalAlignment="Left" CornerRadius="10" 
            BorderThickness="1" BorderBrush="#FFF3F3F3" Background="White">
            <Button x:Name="animalChickenBtn" Click="ChickenButton_Click" Content="Chicken"  
                FontSize="15" Foreground="#FFB9B9B9" Background="White" BorderBrush="White" 
                Style="{StaticResource NoHoverButton}" Margin="9,4,9,4"/>
        </Border>

        <Label Content="Animal:" HorizontalAlignment="Left" Margin="32,281,0,0" VerticalAlignment="Top" FontSize="15"/>
        <Label Content="Name:" HorizontalAlignment="Left" Margin="252,73,0,0" VerticalAlignment="Top" FontSize="20"/>
        <Label Content="Product Type:" HorizontalAlignment="Left" Margin="32,404,0,0" VerticalAlignment="Top" FontSize="15"/>

        <Border x:Name="animalDogBorder" Height="39" Width="56" VerticalAlignment="Top" 
            Margin="113,316,0,0" HorizontalAlignment="Left" CornerRadius="10" 
            BorderThickness="1" BorderBrush="#FFF3F3F3" Background="White">
            <Button x:Name="animalDogBtn" Click="DogButton_Click" Content="Dog"  
                FontSize="15" Foreground="#FFB9B9B9" Background="White" BorderBrush="White" 
                Style="{StaticResource NoHoverButton}" Margin="9,4,9,4"/>
        </Border>

        <Border x:Name="animalCatBorder" Height="39" Width="56" VerticalAlignment="Top" 
            Margin="174,316,0,0" HorizontalAlignment="Left" CornerRadius="10" 
            BorderThickness="1" BorderBrush="#FFF3F3F3" Background="White">
            <Button x:Name="animalCatBtn" Click="CatButton_Click" Content="Cat"  
                FontSize="15" Foreground="#FFB9B9B9" Background="White" BorderBrush="White" 
                Style="{StaticResource NoHoverButton}" Margin="9,4,9,4"/>
        </Border>
        <Border x:Name="animalPigBorder" Height="39" Width="47" VerticalAlignment="Top" 
            Margin="235,316,0,0" HorizontalAlignment="Left" CornerRadius="10" 
            BorderThickness="1" BorderBrush="#FFF3F3F3" Background="White">
            <Button x:Name="animalPigBtn" Click="PigButton_Click" Content="Pig"  
                FontSize="15" Foreground="#FFB9B9B9" Background="White" BorderBrush="White" 
                Style="{StaticResource NoHoverButton}" Margin="9,4,9,4"/>
        </Border>

        <Border x:Name="animalGuineaBorder" Height="39" Width="93" VerticalAlignment="Top" 
            Margin="287,316,0,0" HorizontalAlignment="Left" CornerRadius="10" 
            BorderThickness="1" BorderBrush="#FFF3F3F3" Background="White">
            <Button x:Name="animalGuineaBtn" Click="GuineaButton_Click" Content="Guinea Pig"  
                FontSize="15" Foreground="#FFB9B9B9" Background="White" BorderBrush="White" 
                Style="{StaticResource NoHoverButton}" Margin="9,4,9,4"/>
        </Border>

        <Border x:Name="animalDuckBorder" Height="39" Width="58" VerticalAlignment="Top" 
            Margin="385,316,0,0" HorizontalAlignment="Left" CornerRadius="10" 
            BorderThickness="1" BorderBrush="#FFF3F3F3" Background="White">
            <Button x:Name="animalDuckBtn" Click="DuckButton_Click" Content="Duck"  
                FontSize="15" Foreground="#FFB9B9B9" Background="White" BorderBrush="White" 
                Style="{StaticResource NoHoverButton}" Margin="9,4,9,4"/>
        </Border>

        <Border x:Name="animalCowBorder" Height="39" Width="55" VerticalAlignment="Top" 
            Margin="448,316,0,0" HorizontalAlignment="Left" CornerRadius="10" 
            BorderThickness="1" BorderBrush="#FFF3F3F3" Background="White">
            <Button x:Name="animalCowBtn" Click="CowButton_Click" Content="Cow"  
                FontSize="15" Foreground="#FFB9B9B9" Background="White" BorderBrush="White" 
                Style="{StaticResource NoHoverButton}" Margin="9,4,9,4"/>
        </Border>

        <Border x:Name="animalHorseBorder" Height="39" Width="65" VerticalAlignment="Top" 
            Margin="508,316,0,0" HorizontalAlignment="Left" CornerRadius="10" 
            BorderThickness="1" BorderBrush="#FFF3F3F3" Background="White">
            <Button x:Name="animalHorseBtn" Click="HorseButton_Click" Content="Horse"  
                FontSize="15" Foreground="#FFB9B9B9" Background="White" BorderBrush="White" 
                Style="{StaticResource NoHoverButton}" Margin="9,4,9,4"/>
        </Border>

        <Border x:Name="animalRabbitBorder" Height="39" Width="65" VerticalAlignment="Top" 
            Margin="32,360,0,0" HorizontalAlignment="Left" CornerRadius="10" 
            BorderThickness="1" BorderBrush="#FFF3F3F3" Background="White">
            <Button x:Name="animalRabbitBtn" Click="RabbitButton_Click" Content="Rabbit"  
                FontSize="15" Foreground="#FFB9B9B9" Background="White" BorderBrush="White" 
                Style="{StaticResource NoHoverButton}" Margin="9,4,9,4"/>
        </Border>

        <Border x:Name="animalBirdBorder" Height="39" Width="50" VerticalAlignment="Top" 
            Margin="102,360,0,0" HorizontalAlignment="Left" CornerRadius="10" 
            BorderThickness="1" BorderBrush="#FFF3F3F3" Background="White">
            <Button x:Name="animalBirdBtn" Click="BirdButton_Click" Content="Bird"  
                FontSize="15" Foreground="#FFB9B9B9" Background="White" BorderBrush="White" 
                Style="{StaticResource NoHoverButton}" Margin="9,4,9,4"/>
        </Border>

        <Border x:Name="animalFishBorder" Height="39" Width="50" VerticalAlignment="Top" 
            Margin="157,360,0,0" HorizontalAlignment="Left" CornerRadius="10" 
            BorderThickness="1" BorderBrush="#FFF3F3F3" Background="White">
            <Button x:Name="animalFishBtn" Click="FishButton_Click" Content="Fish"  
                FontSize="15" Foreground="#FFB9B9B9" Background="White" BorderBrush="White" 
                Style="{StaticResource NoHoverButton}" Margin="9,4,9,4"/>
        </Border>


        <Border x:Name="typeFeedsBorder" Height="39" Width="59" VerticalAlignment="Top" 
            Margin="32,439,0,0" HorizontalAlignment="Left" CornerRadius="10" 
            BorderThickness="1" BorderBrush="#FFF3F3F3" Background="White">
            <Button x:Name="typeFeedsBtn" Click="FeedsButton_Click" Content="Feeds"  
                FontSize="15" Foreground="#FFB9B9B9" Background="White" BorderBrush="White" 
                Style="{StaticResource NoHoverButton}" Margin="9,4,9,0" Height="29" VerticalAlignment="Top"/>
        </Border>

        <Border x:Name="typeMedicineBorder" Height="39" Width="82" VerticalAlignment="Top" 
            Margin="96,439,0,0" HorizontalAlignment="Left" CornerRadius="10" 
            BorderThickness="1" BorderBrush="#FFF3F3F3" Background="White">
            <Button x:Name="typeMedicineBtn" Click="MedicineButton_Click" Content="Medicine"  
                FontSize="15" Foreground="#FFB9B9B9" Background="White" BorderBrush="White" 
                Style="{StaticResource NoHoverButton}" Margin="9,4,9,4"/>
        </Border>

        <Border x:Name="typeVitaminsBorder" Height="39" Width="82" VerticalAlignment="Top" 
            Margin="183,439,0,0" HorizontalAlignment="Left" CornerRadius="10" 
            BorderThickness="1" BorderBrush="#FFF3F3F3" Background="White">
            <Button x:Name="typeVitaminsBtn" Click="VitaminsButton_Click" Content="Vitamins"  
                FontSize="15" Foreground="#FFB9B9B9" Background="White" BorderBrush="White" 
                Style="{StaticResource NoHoverButton}" Margin="9,4,9,4"/>
        </Border>
        <Border x:Name="typeAccessoriesBorder" Height="39" Width="100" VerticalAlignment="Top" 
            Margin="270,439,0,0" HorizontalAlignment="Left" CornerRadius="10" 
            BorderThickness="1" BorderBrush="#FFF3F3F3" Background="White">
            <Button x:Name="typeAccessoriesBtn" Click="AccessoriesButton_Click" Content="Accessories"  
                FontSize="15" Foreground="#FFB9B9B9" Background="White" BorderBrush="White" 
                Style="{StaticResource NoHoverButton}" Margin="9,4,9,4"/>
        </Border>
        <Border x:Name="typeVaccinesBorder" Height="39" Width="77" VerticalAlignment="Top" 
            Margin="375,439,0,0" HorizontalAlignment="Left" CornerRadius="10" 
            BorderThickness="1" BorderBrush="#FFF3F3F3" Background="White">
            <Button x:Name="typeVaccinesBtn" Click="VaccinesButton_Click" Content="Vaccines"  
                FontSize="15" Foreground="#FFB9B9B9" Background="White" BorderBrush="White" 
                Style="{StaticResource NoHoverButton}" Margin="9,4,9,4"/>
        </Border>

        <Border CornerRadius="10" BorderBrush="#FFDDDDDD" BorderThickness="1" Margin="252,209,27,466" Background="White" Height="46">

            <ComboBox x:Name="SupplierCBox"  Margin="9,5,9,5" Background="Transparent" BorderBrush="Transparent">
                <ComboBox.Style>
                    <Style TargetType="{x:Type ComboBox}">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ComboBox}">
                                    <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                        <Grid>
                                            <!-- Define two columns, with the second for the dropdown icon -->
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <ContentPresenter x:Name="ContentSite"
                                                  IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  Margin="5,3,23,3"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"/>

                                            <ToggleButton x:Name="ToggleButton"
                                              Background="{TemplateBinding Background}"
                                              BorderBrush="{TemplateBinding BorderBrush}"
                                              BorderThickness="0"
                                              Grid.Column="1"
                                              Focusable="false"
                                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                              ClickMode="Press">
                                                <Path Fill="Black" Data="M 0 0 L 4 4 L 8 0 Z" Margin="0,0,4,0" />
                                            </ToggleButton>

                                            <Popup x:Name="Popup"
                                       Placement="Bottom"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="Slide">
                                                <Grid x:Name="DropDown"
                                          SnapsToDevicePixels="True"
                                          MinWidth="{TemplateBinding ActualWidth}"
                                          MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                                    <Border x:Name="DropDownBorder"
                                                Background="White"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1"/>
                                                    <ScrollViewer Margin="4,6,4,6"
                                                      SnapsToDevicePixels="True">
                                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                                    </ScrollViewer>
                                                </Grid>
                                            </Popup>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Border" Property="Background" Value="Gray"/>
                                            <Setter Property="Foreground" Value="DarkGray"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Border" Property="BorderBrush" Value="Transparent"/>
                                        </Trigger>
                                        <Trigger Property="IsDropDownOpen" Value="True">
                                            <Setter TargetName="Border" Property="BorderBrush" Value="Transparent"/>
                                        </Trigger>
                                        <Trigger Property="HasItems" Value="False">
                                            <Setter TargetName="DropDownBorder" Property="BorderThickness" Value="0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                    </Style>
                </ComboBox.Style>
                <ComboBoxItem Content="Item1"/>
                <ComboBoxItem Content="Item2"/>
                <ComboBoxItem Content="Item3"/>
                <ComboBoxItem Content="Item4"/>
            </ComboBox>



        </Border>
        <Label Content="Supplier:" HorizontalAlignment="Left" Margin="252,166,0,0" VerticalAlignment="Top" FontSize="20"/>
        <Label Content="Variations: " HorizontalAlignment="Left" Margin="20,503,0,0" VerticalAlignment="Top" FontSize="15"/>
        <Border CornerRadius="10                 " BorderBrush="#FFDDDDDD" BorderThickness="1" Margin="252,114,27,561" Background="White">
            <TextBox x:Name="ProductNameTextBox" GotFocus="ProductName_GotFocus" LostFocus="ProductName_LostFocus" 
         HorizontalAlignment="Center" TextWrapping="Wrap" 
         Text="Enter text here..." VerticalAlignment="Center" 
         Width="325" Height="26" FontSize="18" Foreground="#FF585858">
                <TextBox.Style>
                    <Style TargetType="{x:Type TextBox}">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="SelectionBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="Transparent"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
        </Border>
        <Border x:Name="typeFeedsBorder_Copy3" Height="35" Width="622" VerticalAlignment="Top" 
            Margin="0,684,0,0" HorizontalAlignment="Center" CornerRadius="0 0 10 10" 
            BorderThickness="1" BorderBrush="#FF077C5E" Background="#FF077C5E">
            <Button Content="Submit" Margin="9,-1,9,-1" Click="Submit_Click" Background="#FF077C5E" Foreground="White" FontWeight="Bold" FontSize="20" BorderThickness="0" Style="{StaticResource NoHoverButton}"/>
        </Border>
        <Label Content="Prices: " HorizontalAlignment="Left" Margin="20,555,0,0" VerticalAlignment="Top" FontSize="15"/>
        <Label Content="Conversion: " HorizontalAlignment="Left" Margin="20,601,0,0" VerticalAlignment="Top" FontSize="15"/>
        <WrapPanel x:Name="unitsWPanel" Width="386" Margin="102,485,136,70" Orientation="Horizontal">
            <Border x:Name="addUnitBtn" 
            CornerRadius="10" 
            BorderThickness="1" 
            BorderBrush="#FF66C265" 
            Background="#FFC0E4BE" 
            Height="55" 
            Width="56" 
            Margin="1,4,0,0" 
            VerticalAlignment="Top">
                <Button Margin="3,4,3,4" 
                Click="AddUnitPopup_Click" 
                BorderBrush="#FFC0E4BE" 
                Background="#FFC0E4BE" 
                Style="{StaticResource NoHoverButton}">
                    <Image Height="39" Width="33" Source="/Images/addbaseunit.png"/>
                </Button>
            </Border>
        </WrapPanel>
        <Label Content="Stocks: " HorizontalAlignment="Left" Margin="20,636,0,0" VerticalAlignment="Top" FontSize="15"/>
        <Label x:Name="stocklisting" Content="stocks " HorizontalAlignment="Left" Margin="111,636,0,0" VerticalAlignment="Top" FontSize="15"/>
        <Label x:Name="stockunit" Content="stocks " HorizontalAlignment="Left" Margin="175,636,0,0" VerticalAlignment="Top" FontSize="15"/>
        <Button x:Name="editBtn"  Content="edit" HorizontalAlignment="Left" Height="30" Margin="474,654,0,0" VerticalAlignment="Top" Width="66"/>
        <Button x:Name="phaseoutBtn"  Content="phaseout" HorizontalAlignment="Left" Height="30" Margin="546,651,0,0" VerticalAlignment="Top" Width="68" Click="Button_Click"/>



    </Grid>
</Window>
