                <Button BorderBrush="Transparent" Background="Transparent" Click="AddSUpplier_Click" Style="{StaticResource NoHoverButton}">
                    <Image Height="22" Width="23" Source="/Images/addorder.png"/>
                </Button>
            </WrapPanel>
        </Border>



    </Grid>
</Window>
