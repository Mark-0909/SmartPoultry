<Window x:Class="SmartPoultry.Dashboard_DisplayOrderDetails"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartPoultry"
        mc:Ignorable="d"
        Title="Dashboard_DisplayOrderDetails" Height="514" Width="502" ResizeMode="NoResize" WindowStyle="None" BorderBrush="Transparent" Background="Transparent" WindowStartupLocation="CenterScreen" AllowsTransparency="True">
    <Grid>
        <Border CornerRadius="10" Background="White" BorderBrush="#FF2C6E5D" BorderThickness="1" HorizontalAlignment="Center" Height="514" VerticalAlignment="Center" Width="502">


        </Border>

        <Border CornerRadius="10 10 0 0" BorderBrush="#FF2C6E5D" BorderThickness="1" HorizontalAlignment="Center" Height="38" VerticalAlignment="Top" Width="502" Background="#FF2C6E5D">
            <Button Click="Close_Click" HorizontalAlignment="Left" Height="26" Margin="470,0,0,0" VerticalAlignment="Center" Width="31" Background="#FF2C6E5D" BorderBrush="#FF2C6E5D">
                <Image Height="24" Width="19" Source="/Images/close.png"/>
            </Button>
        </Border>
        <Border CornerRadius="0 0 10 10" BorderBrush="#FF2C6E5D" BorderThickness="1" HorizontalAlignment="Center" Height="32" Margin="0,482,0,0" VerticalAlignment="Top" Width="502" Background="#FF2C6E5D">
            <Button Content="CONFIRM" HorizontalAlignment="Center" Height="27" VerticalAlignment="Center" Width="412" BorderBrush="#FF2C6E5D" Background="#FF2C6E5D" FontSize="15" Click="ConfirmButton_Click" Foreground="White" FontWeight="Bold"/>
        </Border>
        <Label HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Content="ORDER DETAILS" HorizontalAlignment="Center" Height="35" VerticalAlignment="Top" Width="220" FontSize="20" Foreground="White" FontWeight="Bold"/>
        <Label Content="Product List:" HorizontalAlignment="Left" Height="25" Margin="9,42,0,0" VerticalAlignment="Top" Width="89"/>
        <ScrollViewer HorizontalAlignment="Center" Height="230" Margin="0,95,0,0" VerticalAlignment="Top" Width="498">
            <WrapPanel x:Name="ListPanel"  Width="475"/>
        </ScrollViewer>
        <Label Content="Name" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Height="25" Margin="10,65,0,0" VerticalAlignment="Top" Width="89"/>
        <Label Content="Quantity" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Height="25" Margin="209,65,0,0" VerticalAlignment="Top" Width="89"/>
        <Label Content="Price" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Height="25" Margin="303,65,0,0" VerticalAlignment="Top" Width="89"/>
        <Label Content="Total" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Height="25" Margin="392,65,0,0" VerticalAlignment="Top" Width="89"/>
        <Label Content="Variation" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Height="25" Margin="115,65,0,0" VerticalAlignment="Top" Width="89"/>
    </Grid>
</Window>
