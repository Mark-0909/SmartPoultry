<UserControl x:Class="SmartPoultry.Supplier"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SmartPoultry"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Width="1104" Height="582" Background="#FFE3E3E3">
    <Grid>
        <!-- Header Label -->
        <Label Content="SUPPLIER" HorizontalAlignment="Left" VerticalAlignment="Top"
               FontSize="30" FontWeight="Bold" Margin="10,4,0,0"/>

        <!-- Main Layout Grid -->
        <Grid Margin="10,50,10,10">
            <Grid.ColumnDefinitions>
                <!-- Supplier List Column (Larger) -->
                <ColumnDefinition Width="2*"/>
                <!-- Supplier Information Column (Smaller) -->
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Supplier List Panel -->
            <Border Grid.Column="0" Background="#FFF" Margin="0,0,10,0" Padding="10">
                <Grid>
                    <!-- Name and Supplier Information Labels -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Label Content="Name" FontWeight="Bold" FontSize="16" Grid.Column="0"/>
                    <Label Content="Supplier Information" FontWeight="Bold" FontSize="16" Grid.Column="1" HorizontalAlignment="Left" Margin="10,0,0,0"/>
                    <ListBox Name="SupplierListBox" ItemTemplate="{StaticResource SupplierControlTemplate}" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                    </ListBox>
                </Grid>
            </Border>

            <!-- Supplier Information Section -->
            <StackPanel Grid.Column="1" Margin="10">
                <TextBlock Text="Supplier Information" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

                <TextBlock Text="Name:" FontWeight="Bold"/>
                <TextBox x:Name="SupplierName" Margin="0,2,0,8"/>

                <TextBlock Text="Contact Person:" FontWeight="Bold"/>
                <TextBox x:Name="ContactPerson" Margin="0,2,0,8"/>

                <TextBlock Text="Phone:" FontWeight="Bold"/>
                <TextBox x:Name="Phone" Margin="0,2,0,8"/>

                <TextBlock Text="Email:" FontWeight="Bold"/>
                <TextBox x:Name="Email" Margin="0,2,0,8"/>

                <TextBlock Text="Address:" FontWeight="Bold"/>
                <TextBox x:Name="Address" Margin="0,2,0,8"/>

                <!-- Supplier Action Buttons -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Add Supplier" Click="AddSupplier_Click" Background="#FF66C265" Margin="0,0,10,0"/>
                    <Button Content="Edit Supplier" Click="EditSupplier_Click" Background="#FF66C265" Margin="0,0,10,0"/>
                    <Button Content="Delete Supplier" Click="DeleteSupplier_Click" Background="#FF66C265"/>
                </StackPanel>

                <!-- Order History Section -->
                <TextBlock Text="Order History" FontSize="18" FontWeight="Bold" Margin="0,20,0,10"/>
                <DataGrid x:Name="OrderHistoryDataGrid" AutoGenerateColumns="False" Height="200">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Order Date" Binding="{Binding OrderDate}" Width="*"/>
                        <DataGridTextColumn Header="Items" Binding="{Binding Items}" Width="*"/>
                        <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="*"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>


