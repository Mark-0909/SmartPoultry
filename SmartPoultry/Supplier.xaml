<UserControl x:Class="SmartPoultry.Supplier"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Width="1104" Height="582" Background="#FFE3E3E3">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="11*"/>
            <RowDefinition Height="439*"/>
        </Grid.RowDefinitions>

        <!-- Header Label -->
        <Label Content="SUPPLIER" HorizontalAlignment="Left" VerticalAlignment="Top"
               FontSize="30" FontWeight="Bold" Margin="10,4,0,0" Grid.RowSpan="2"/>

        <!-- Main Layout Grid -->
        <Grid Margin="10,39,10,10" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Supplier List Column -->
                <ColumnDefinition Width="2.5*"/>
                <!-- Supplier Information Column -->
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>

            <!-- Supplier List Panel -->
            <Border Grid.Column="0" Background="#FFF" Margin="0,43,10,0" Padding="10">
                <ScrollViewer HorizontalAlignment="Center" VerticalAlignment="Top" Width="620"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <WrapPanel x:Name="SupplierListPanel" />
                </ScrollViewer>
            </Border>

            <!-- Supplier Information Section -->
            <StackPanel Grid.Column="1" Margin="10">
                <TextBlock Text="Add a Supplier" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

                <!-- Name and Contact Person -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Name:" FontWeight="Bold"/>
                        <TextBox x:Name="SupplierName" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Contact Person:" FontWeight="Bold"/>
                        <TextBox x:Name="ContactPerson" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Phone and Email -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Phone:" FontWeight="Bold"/>
                        <TextBox x:Name="Phone" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Email:" FontWeight="Bold"/>
                        <TextBox x:Name="Email" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Address -->
                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="Address:" FontWeight="Bold"/>
                    <TextBox x:Name="Address" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Add Supplier Button -->
                <Button Content="Add Supplier" Click="AddSupplier_Click" Background="#FF66C265" Margin="0,10,0,0" Width="150" HorizontalAlignment="Left"/>
            </StackPanel>
            <Label Content="Name" HorizontalAlignment="Left" Margin="65,9,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
            <Label Content="Contact Person" HorizontalAlignment="Left" Margin="196,9,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
            <Label Content="Contact Info" HorizontalAlignment="Left" Margin="379,9,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
        </Grid>
    </Grid>
</UserControl>
