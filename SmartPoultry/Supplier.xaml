<UserControl x:Class="SmartPoultry.Supplier"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SmartPoultry"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Width="1104" Height="582" Background="#FFE3E3E3">
    <Grid>
        <!-- Header Label -->
        <Label Content="SUPPLIER" HorizontalAlignment="Left" VerticalAlignment="Top"
           FontSize="30" FontWeight="Bold" Margin="10,4,0,0"/>

        <!-- Main Layout Grid -->
        <Grid Margin="10,50,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <!-- Supplier List Column -->
                <ColumnDefinition Width="*"/>
                <!-- Supplier Details Column -->
            </Grid.ColumnDefinitions>

            <!-- Supplier List Panel -->
            <Border Grid.Column="0" Background="#FFF" Margin="0,0,10,0">
                <Label Content="Name" RenderTransformOrigin="0.425,0.393" Margin="10,10,157,312"/>
            </Border>

            <!-- Supplier Details Panel -->
            <StackPanel Grid.Column="1" Background="#FFF"  
                    >
                <!-- Supplier Information Section -->
                <TextBlock Text="Supplier Information" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

                <TextBlock Text="Name:" FontWeight="Bold"/>
                <TextBox x:Name="SupplierName" IsReadOnly="True" Margin="0,2,0,8"/>
                <TextBlock Text="Contact Person:" FontWeight="Bold"/>
                <TextBox x:Name="ContactPerson" IsReadOnly="True" Margin="0,2,0,8"/>
                <TextBlock Text="Phone:" FontWeight="Bold"/>
                <TextBox x:Name="Phone" IsReadOnly="True" Margin="0,2,0,8"/>
                <TextBlock Text="Email:" FontWeight="Bold"/>
                <TextBox x:Name="Email" IsReadOnly="True" Margin="0,2,0,8"/>
                <TextBlock Text="Address:" FontWeight="Bold"/>
                <TextBox x:Name="Address" IsReadOnly="True" Margin="0,2,0,8"/>

                <!-- Supplier Action Buttons -->

                <!-- Order History Section -->
                <TextBlock Text="Order History" FontSize="18" FontWeight="Bold" Margin="0,20,0,10"/>
                <DataGrid x:Name="OrderHistoryDataGrid" AutoGenerateColumns="False" Margin="0,0,0,0" Height="200">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Order Date" Binding="{Binding OrderDate}" Width="*"/>
                        <DataGridTextColumn Header="Items" Binding="{Binding Items}" Width="*"/>
                        <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="*"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <local:inventory/>
            </StackPanel>
        </Grid>
        <Label Content="Category" HorizontalAlignment="Left" Margin="160,65,0,0" VerticalAlignment="Top"/>
        <Border BorderBrush="#FF66C265" BorderThickness="1" Margin="266,304,430,122" CornerRadius="5
                " Background="#FFC0E4BE">
            <Button Content="Add Supplier" Click="AddSupplier_Click" Background="#00000000" BorderBrush="#00000000" Foreground="#FF66C265" Margin="3,3,-1,-1"/>
        </Border>
        <Border BorderBrush="#FF66C265" BorderThickness="1" Margin="389,304,307,122" CornerRadius="5" Background="#FFC0E4BE">
            <Button Content="Edit Supplier" Click="EditSupplier_Click" Background="#00000000" BorderBrush="#00000000" Foreground="#FF66C265" Margin="3,1,-1,1"/>
        </Border>
        <Border BorderBrush="#FF66C265" BorderThickness="1" Margin="512,304,178,122" CornerRadius="5" Background="#FFC0E4BE">
            <Button Content="Delete Supplier" Click="DeleteSupplier_Click" Background="#00000000" BorderBrush="#00000000" Foreground="#FF66C265" Margin="4,1,4,1"/>
        </Border>
    </Grid>
</UserControl>
