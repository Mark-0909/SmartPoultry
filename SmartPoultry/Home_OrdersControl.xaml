<UserControl x:Class="SmartPoultry.Home_OrdersControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SmartPoultry"
             mc:Ignorable="d" 
             d:DesignHeight="54" Width="315" Height="54" Background="Transparent" Margin="0 2 0 0">
    <Grid>
        <Border x:Name="controlBorder" CornerRadius="10" BorderBrush="#FFF2F2F2" BorderThickness="1" Background="#FFD4D4D4">
            <Button x:Name="PlusBtn" Click="PlusBtn_Click" HorizontalAlignment="Left" Height="20" VerticalAlignment="Center" Width="18" Background="Transparent" BorderBrush="Transparent" Margin="143,0,0,0">
                <Image Height="16" Width="14" Source="/Images/addorder.png" OpacityMask="Black"/>
            </Button>
        </Border>
        <Label x:Name="prodName" Content="Product Name" 
            HorizontalAlignment="Left" 
            VerticalAlignment="Center" 
            Height="46" 
            Width="87" 
            Margin="3,0,0,0" 
            HorizontalContentAlignment="Center" 
            VerticalContentAlignment="Center"/>
        <Label x:Name="pricelabel" Content="0.00" 
            HorizontalAlignment="Left" 
            VerticalAlignment="Center" 
            Height="46" 
            Width="67" 
            Margin="226,0,0,0" 
            HorizontalContentAlignment="Center" 
            VerticalContentAlignment="Center" FontSize="13"/>
        <Label x:Name="quantitylabel"  Content="1" 
            HorizontalAlignment="Left" 
            VerticalAlignment="Center" 
            Height="46" 
            Width="31" 
            HorizontalContentAlignment="Center" 
            VerticalContentAlignment="Center" Margin="120,0,0,0"/>
        <Button x:Name="MinusBtn" Click="MinusBtn_Click" HorizontalAlignment="Left" Height="18" Margin="108,0,0,0" VerticalAlignment="Center" Width="18" Background="Transparent" BorderBrush="Transparent">
            <Image Height="15" Width="14" Source="/Images/minusorder.png"/>
        </Button>
        <Button x:Name="RemoveBtn" Click="RemoveBtn_Click" HorizontalAlignment="Left" Height="18" Margin="293,0,0,0" VerticalAlignment="Center" Width="18" Background="Transparent" BorderBrush="Transparent">
            <Image Height="15" Width="14" Source="/Images/removeorder.png"/>
        </Button>
        <Label x:Name="varName" Content="var" 
            HorizontalAlignment="Left" 
            VerticalAlignment="Center" 
            Height="46" 
            Width="34" 
            Margin="172,0,0,0" 
            HorizontalContentAlignment="Center" 
            VerticalContentAlignment="Center" FontSize="13"/>
        <Label Content="₱" 
            HorizontalAlignment="Left" 
            VerticalAlignment="Center" 
            Height="46" 
            Width="18" 
            Margin="208,0,0,0" 
            HorizontalContentAlignment="Left" 
            VerticalContentAlignment="Center" FontSize="13"/>
    </Grid>
</UserControl>
