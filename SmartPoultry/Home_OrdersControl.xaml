<UserControl x:Class="SmartPoultry.Home_OrdersControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SmartPoultry"
             mc:Ignorable="d" 
             d:DesignHeight="54" Width="299" Height="54" Background="Transparent" Margin="5 5 0 0">
    <Grid>
        <Border CornerRadius="10" BorderBrush="White" BorderThickness="1" Background="#FFC9C9C9">
            <Button x:Name="PlusBtn" Click="PlusBtn_Click" HorizontalAlignment="Left" Height="19" Margin="107,0,0,0" VerticalAlignment="Center" Width="18" Background="Transparent" BorderBrush="Transparent">
                <Image Height="16" Width="14" Source="/Images/addorder.png" OpacityMask="Black"/>
            </Button>
        </Border>
        <Label x:Name="productName" Content="Product Name" 
            HorizontalAlignment="Left" 
            VerticalAlignment="Center" 
            Height="46" 
            Width="87" 
            Margin="7,0,0,0" 
            HorizontalContentAlignment="Center" 
            VerticalContentAlignment="Center"/>
        <Label x:Name="pricelabel" Content="Price" 
            HorizontalAlignment="Left" 
            VerticalAlignment="Center" 
            Height="46" 
            Width="40" 
            Margin="221,0,0,0" 
            HorizontalContentAlignment="Center" 
            VerticalContentAlignment="Center"/>
        <Label x:Name="quantitylabel"  Content="1" 
            HorizontalAlignment="Left" 
            VerticalAlignment="Center" 
            Height="46" 
            Width="31" 
            HorizontalContentAlignment="Center" 
            VerticalContentAlignment="Center" Margin="123,0,0,0"/>
        <Button x:Name="MinusBtn" Click="MinusBtn_Click" HorizontalAlignment="Left" Height="19" Margin="150,0,0,0" VerticalAlignment="Center" Width="18" Background="Transparent" BorderBrush="Transparent">
            <Image Height="15" Width="14" Source="/Images/minusorder.png"/>
        </Button>
        <Button x:Name="RemoveBtn" Click="RemoveBtn_Click" HorizontalAlignment="Left" Height="19" Margin="273,0,0,0" VerticalAlignment="Center" Width="18" Background="Transparent" BorderBrush="Transparent">
            <Image Height="15" Width="14" Source="/removeorder.png"/>
        </Button>
        <Label x:Name="varName" Content="var" 
            HorizontalAlignment="Left" 
            VerticalAlignment="Center" 
            Height="46" 
            Width="34" 
            Margin="174,0,0,0" 
            HorizontalContentAlignment="Center" 
            VerticalContentAlignment="Center"/>
        <Label Content="₱" 
            HorizontalAlignment="Left" 
            VerticalAlignment="Center" 
            Height="46" 
            Width="23" 
            Margin="204,0,0,0" 
            HorizontalContentAlignment="Center" 
            VerticalContentAlignment="Center"/>
    </Grid>
</UserControl>
