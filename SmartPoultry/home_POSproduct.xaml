<UserControl x:Class="SmartPoultry.home_POSproduct"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SmartPoultry"
             mc:Ignorable="d" 
             mc:Ignorable="d" Height="269" Width="217" Background="Transparent" Margin="5 0 0 5">
    <Grid>
        <Border CornerRadius="10" BorderBrush="Black" BorderThickness="1" Background="White">
            <Border CornerRadius="5" BorderBrush="#FFC9C6C6" BorderThickness="1" Margin="9,9,9,84">
                <Image x:Name="Productimage"/>
            </Border>
        </Border>
        <Label x:Name="Productname" Content="Product Name" HorizontalAlignment="Center" Height="29" Margin="0,184,0,0" VerticalAlignment="Top" Width="197" FontSize="15"/>
        <WrapPanel x:Name="vartypesPanel" HorizontalAlignment="Center" Height="41" Margin="0,218,0,0" VerticalAlignment="Center" Width="197"/>

    </Grid>
</UserControl>
