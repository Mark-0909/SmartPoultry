<UserControl x:Class="SmartPoultry.Login_CreateAccount"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SmartPoultry"
             mc:Ignorable="d" Width="390" Height="526">
    <Grid>
        <Border CornerRadius="10" BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Center" Height="526" VerticalAlignment="Center" Width="390" Background="#FF9AB989"/>
        <Label Content="Create Username: " HorizontalAlignment="Left" Height="26" Margin="64,65,0,0" VerticalAlignment="Top" Width="132" FontSize="15"/>
        <Label Content="Create Password: " HorizontalAlignment="Left" Height="26" Margin="64,124,0,0" VerticalAlignment="Top" Width="144" FontSize="15"/>
        <Button Click="Submit_Clicked" x:Name="SubmitBtn" Content="CREATE ACCOUNT" HorizontalAlignment="Left" Height="34" Margin="62,445,0,0" VerticalAlignment="Top" Width="282" FontWeight="Bold"/>
        <Label Content="Confirm Password: " HorizontalAlignment="Left" Height="26" Margin="64,183,0,0" VerticalAlignment="Top" Width="149" FontSize="15"/>
        <Label Content="First Pet's Name:" HorizontalAlignment="Left" Height="26" Margin="64,242,0,0" VerticalAlignment="Top" Width="118" FontSize="15"/>
        <Label Content="Favorite Color:" HorizontalAlignment="Left" Height="26" Margin="64,301,0,0" VerticalAlignment="Top" Width="118" FontSize="15"/>
        <Label Content="Favorite book or movie:" HorizontalAlignment="Left" Height="26" Margin="64,360,0,0" VerticalAlignment="Top" Width="172" FontSize="15"/>
        <Label HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Content="CREATE ADMIN ACCOUNT" HorizontalAlignment="Center" Height="43" Margin="0,10,0,0" VerticalAlignment="Top" Width="390" FontSize="30" FontWeight="Bold"/>
        <Border CornerRadius="5                 " BorderBrush="DarkGray" BorderThickness="1" HorizontalAlignment="Left" Height="33" Margin="64,91,0,0" VerticalAlignment="Top" Width="282" Background="White">
            <TextBox x:Name="usernameTB" VerticalContentAlignment="Center" HorizontalAlignment="Center" Height="25" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Center" Width="268" Padding="1" Background="Transparent" BorderBrush="Transparent" FontSize="14"/>
        </Border>
        <Border CornerRadius="5                 " BorderBrush="DarkGray" BorderThickness="1" HorizontalAlignment="Left" Height="33" Margin="62,268,0,0" VerticalAlignment="Top" Width="282" Background="White">
            <TextBox x:Name="q1TB" VerticalContentAlignment="Center" HorizontalAlignment="Center" Height="25" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Center" Width="268" Padding="1" Background="Transparent" BorderBrush="Transparent" FontSize="14"/>
        </Border>
        <Border CornerRadius="5                 " BorderBrush="DarkGray" BorderThickness="1" HorizontalAlignment="Left" Height="33" Margin="62,150,0,0" VerticalAlignment="Top" Width="282" Background="White">
            <PasswordBox x:Name="passwordTB" HorizontalAlignment="Right" Height="25" VerticalAlignment="Center" Width="270" Background="Transparent" BorderBrush="Transparent" VerticalContentAlignment="Center" Padding="1" Margin="0,0,5,0"/>
        </Border>
        <Border CornerRadius="5                 " BorderBrush="DarkGray" BorderThickness="1" HorizontalAlignment="Left" Height="33" Margin="62,209,0,0" VerticalAlignment="Top" Width="282" Background="White">
            <PasswordBox x:Name="confirmpassTB" HorizontalAlignment="Center" Height="25" VerticalAlignment="Center" Width="270" Background="Transparent" BorderBrush="Transparent" VerticalContentAlignment="Center" Padding="1"/>
        </Border>
        <Border CornerRadius="5                 " BorderBrush="DarkGray" BorderThickness="1" HorizontalAlignment="Left" Height="33" Margin="62,327,0,0" VerticalAlignment="Top" Width="282" Background="White">
            <TextBox x:Name="q2TB" VerticalContentAlignment="Center" HorizontalAlignment="Center" Height="25" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Center" Width="268" Padding="1" Background="Transparent" BorderBrush="Transparent" FontSize="14"/>
        </Border>
        <Border CornerRadius="5                 " BorderBrush="DarkGray" BorderThickness="1" HorizontalAlignment="Left" Height="33" Margin="62,386,0,0" VerticalAlignment="Top" Width="282" Background="White">
            <TextBox x:Name="q3TB" VerticalContentAlignment="Center" HorizontalAlignment="Center" Height="25" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Center" Width="268" Padding="1" Background="Transparent" BorderBrush="Transparent" FontSize="14"/>
        </Border>

    </Grid>
</UserControl>
