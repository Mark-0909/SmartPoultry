<UserControl x:Class="SmartPoultry.Supplier_SupplierControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SmartPoultry"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="600" Width="600" Height="97">
    <Grid>
        <Border CornerRadius="10" BorderBrush="Black" BorderThickness="1" VerticalAlignment="Center" Background="White" Height="57">
            <Label x:Name="ContactInfo"  Content="CONTACT INFO" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="458,0,0,0" Width="99"/>
        </Border>
        <Label x:Name="Name" Content="NAME" HorizontalAlignment="Left" Margin="32,0,0,0" VerticalAlignment="Center" Width="59"/>
        <Label x:Name="ContactPerson" Content="CONTACT PERSON" HorizontalAlignment="Center" VerticalAlignment="Center" Width="161"/>
    </Grid>
</UserControl>

