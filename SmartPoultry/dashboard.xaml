<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SmartPoultry"
    xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf" 
    x:Class="SmartPoultry.dashboard"
    mc:Ignorable="d" 
    d:DesignHeight="644" d:DesignWidth="1123" Background="#FFE3E3E3" Width="1123" Height="644">
    <Grid>
        <Border CornerRadius="10" BorderBrush="White" BorderThickness="1" HorizontalAlignment="Left" Height="114" Margin="10,67,0,0" VerticalAlignment="Top" Width="341" Background="White"/>


        <Label Content="DASHBOARD" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="30" FontWeight="Bold" Margin="10,4,0,0" Width="235"/>
        <Border CornerRadius="10" BorderBrush="#FF2C6E5D" BorderThickness="0" HorizontalAlignment="Left" Height="268" Margin="10,212,0,0" VerticalAlignment="Top" Width="341" Background="White">
            <ScrollViewer x:Name="OrdersList" HorizontalAlignment="Center" Height="234" Margin="0,34,0,0" VerticalAlignment="Top" Width="341" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden" HorizontalContentAlignment="Center">
                <WrapPanel x:Name="OrderListPanel" Width="341"/>
            </ScrollViewer>
        </Border>
        <Border CornerRadius="10" BorderBrush="Black" BorderThickness="0" HorizontalAlignment="Left" Height="244" Margin="361,59,0,0" VerticalAlignment="Top" Width="733" Background="White">
            <Border CornerRadius="10 10 0 0" BorderThickness="1" HorizontalAlignment="Center" Height="36" VerticalAlignment="Top" Width="733" Background="#FF2C6E5D" BorderBrush="#FF2C6E5D">
                <Label Content="Charts" HorizontalAlignment="Left" Height="37" VerticalAlignment="Center" Width="140" Foreground="White" FontSize="20" Margin="9,0,0,0"/>
            </Border>
        </Border>
        <Border CornerRadius="10" BorderBrush="Black" BorderThickness="0" HorizontalAlignment="Left" Height="254" Margin="732,380,0,0" VerticalAlignment="Top" Width="381" Background="White">
            <Border CornerRadius="10 10 0 0" BorderThickness="1" HorizontalAlignment="Center" Height="36" VerticalAlignment="Top" Width="382" Background="#FF2C6E5D" BorderBrush="#FF2C6E5D">
                <Label Content="Pending Delivery" HorizontalAlignment="Left" Height="36" VerticalAlignment="Center" Width="171" Foreground="White" FontSize="20" Margin="9,0,0,0"/>
            </Border>
        </Border>
        <Border CornerRadius="10" BorderBrush="Black" BorderThickness="0" HorizontalAlignment="Left" Height="254" Margin="361,380,0,0" VerticalAlignment="Top" Width="361" Background="White">
            <Border CornerRadius="10 10 0 0" BorderThickness="1" HorizontalAlignment="Center" Height="36" VerticalAlignment="Top" Width="361" Background="#FF2C6E5D" BorderBrush="#FF2C6E5D">
                <Label Content="Scheduled Payments" HorizontalAlignment="Left" Height="36" VerticalAlignment="Center" Width="228" Foreground="White" FontSize="20" Margin="9,0,0,0"/>
            </Border>
        </Border>
        <Border CornerRadius="10 10 0 0" BorderThickness="1" HorizontalAlignment="Left" Height="36" Margin="10,186,0,0" VerticalAlignment="Top" Width="341" Background="#FF2C6E5D" BorderBrush="#FF2C6E5D">
            <Label Content="Transaction" HorizontalAlignment="Left" Height="37" VerticalAlignment="Center" Width="140" Foreground="White" FontSize="20" Margin="9,0,0,0"/>
        </Border>
        <Label Content="Payment" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Height="27" Margin="93,221,0,0" VerticalAlignment="Top" Width="102"/>
        <Label Content="Status" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Height="27" Margin="187,221,0,0" VerticalAlignment="Top" Width="53"/>
        <Label Content="Total" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Height="27" Margin="251,221,0,0" VerticalAlignment="Top" Width="55"/>
        <Label Content="ID" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Height="28" Margin="49,221,0,0" VerticalAlignment="Top" Width="35"/>
        <ComboBox x:Name="FinancialLiabilitiesCbox" HorizontalAlignment="Left" Height="20" Margin="638,388,0,0" VerticalAlignment="Top" Width="77" RenderTransformOrigin="0.508,0.582" SelectedIndex="0" SelectionChanged="FinancialCB_SelectionChanged">
            <ComboBoxItem Content="To Pay"/>
            <ComboBoxItem Content="To Receive"/>
        </ComboBox>
        <ComboBox x:Name="DeliveryCBox" HorizontalAlignment="Left" Height="20" Margin="1028,388,0,0" VerticalAlignment="Top" Width="77" SelectedIndex="0" SelectionChanged="DeliveryCB_SelectionChanged">
            <ComboBoxItem Content="To Deliver"/>
            <ComboBoxItem Content="To Receive"/>
        </ComboBox>
        <Button Click="AddFinancialLiabilities_Click" HorizontalAlignment="Left" Height="26" Margin="605,385,0,0" VerticalAlignment="Top" Width="28" Background="#FF2C6E5D" BorderBrush="#FF2C6E5D">
            <Image Height="17" Width="18" Source="/Images/addicon.png" RenderTransformOrigin="0.528,0.5"/>
        </Button>
        <Label Content="Name" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Height="27" Margin="400,420,0,0" VerticalAlignment="Top" Width="52"/>
        <Label Content="Due Date" HorizontalContentAlignment="Center" HorizontalAlignment="Center" Height="27" Margin="-72,420,0,0" VerticalAlignment="Top" Width="64"/>
        <Label Content="Amount" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Height="27" Margin="587,420,0,0" VerticalAlignment="Top" Width="68"/>
        <Label Content="Date" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Height="27" Margin="848,420,0,0" VerticalAlignment="Top" Width="94"/>
        <Label Content="Status" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Height="27" Margin="940,420,0,0" VerticalAlignment="Top" Width="92"/>
        <Label Content="Name" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Height="27" Margin="759,420,0,0" VerticalAlignment="Top" Width="74"/>
        <ScrollViewer  HorizontalAlignment="Left" Height="191" Margin="361,443,0,0" VerticalAlignment="Top" Width="361" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
            <WrapPanel x:Name="FinancilaLiabilitiesPanel"  Width="344" />
        </ScrollViewer>
        <ScrollViewer   HorizontalAlignment="Left" Height="193" Margin="732,441,0,0" VerticalAlignment="Top" Width="381" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
            <WrapPanel x:Name="DeliveriesPanel1"   Width="364"/>
        </ScrollViewer>
        <Border CornerRadius="10 10 0 0" BorderThickness="1" HorizontalAlignment="Left" Height="36" Margin="10,59,0,0" VerticalAlignment="Top" Width="341" Background="#FF2C6E5D" BorderBrush="#FF2C6E5D">
            <Label Content="Today's Log" HorizontalAlignment="Left" Height="37" VerticalAlignment="Center" Width="140" Foreground="White" FontSize="20" Margin="9,0,0,0"/>
        </Border>
        <Border CornerRadius="10" BorderBrush="Black" BorderThickness="0" HorizontalAlignment="Left" Height="310" Margin="361,59,0,0" VerticalAlignment="Top" Width="752" Background="White">
            <Border CornerRadius="10 10 0 0" BorderThickness="1" HorizontalAlignment="Center" Height="36" VerticalAlignment="Top" Width="752" Background="#FF2C6E5D" BorderBrush="#FF2C6E5D">
                <Label Content="Charts" HorizontalAlignment="Left" Height="37" VerticalAlignment="Center" Width="140" Foreground="White" FontSize="20" Margin="9,0,0,0"/>
            </Border>
        </Border>
        <Border BorderThickness="0,0,0.5,0.5" BorderBrush="Black" HorizontalAlignment="Left" Height="16" Margin="10,95,0,0" VerticalAlignment="Top" Width="85"/>
        <Border BorderThickness="0,0,0.5,0.5" BorderBrush="Black" HorizontalAlignment="Left" Height="16" Margin="95,95,0,0" VerticalAlignment="Top" Width="85"/>
        <Border BorderThickness="0,0,0.5,0.5" BorderBrush="Black" HorizontalAlignment="Left" Height="16" Margin="180,95,0,0" VerticalAlignment="Top" Width="85">
            <Label Content="To Pay" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Center" Height="24" VerticalAlignment="Center" Width="85" FontSize="10" FontWeight="Bold"/>
        </Border>
        <Border BorderThickness="0,0,0,0.5" BorderBrush="Black" HorizontalAlignment="Left" Height="16" Margin="265,95,0,0" VerticalAlignment="Top" Width="86">
            <Label Content="Out of Stock" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Center" Height="21" VerticalAlignment="Top" Width="86" FontSize="10" FontWeight="Bold" Margin="0,-4,0,0"/>
        </Border>
        <Border BorderThickness="0,0,0.5,0" BorderBrush="Black" HorizontalAlignment="Left" Height="70" Margin="10,111,0,0" VerticalAlignment="Top" Width="85"/>
        <Border BorderThickness="0,0,0.5,0" BorderBrush="Black" HorizontalAlignment="Left" Height="70" Margin="95,111,0,0" VerticalAlignment="Top" Width="85"/>
        <Border BorderThickness="0,0,0.5,0" BorderBrush="Black" HorizontalAlignment="Left" Height="70" Margin="180,111,0,0" VerticalAlignment="Top" Width="85"/>
        <Border BorderThickness="0,0,0,0" BorderBrush="Black" HorizontalAlignment="Left" Height="70" Margin="265,111,0,0" VerticalAlignment="Top" Width="86"/>
        <Label Content="Orders" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Left" Height="21" Margin="10,91,0,0" VerticalAlignment="Top" Width="85" FontSize="10" FontWeight="Bold"/>
        <Label Content="To Deliver" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Left" Height="21" Margin="95,91,0,0" VerticalAlignment="Top" Width="85" FontSize="10" FontWeight="Bold"/>
        <Label x:Name="OrdersLabel"  Content="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Left" Height="70" Margin="10,111,0,0" VerticalAlignment="Top" Width="85" FontSize="40" FontWeight="Bold"/>
        <Label x:Name="ToDeliverLabel" Content="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Left" Height="70" Margin="95,111,0,0" VerticalAlignment="Top" Width="85" FontSize="40" FontWeight="Bold"/>
        <Label x:Name="ToPayLabel" Content="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Left" Height="70" Margin="180,111,0,0" VerticalAlignment="Top" Width="85" FontSize="40" FontWeight="Bold"/>
        <Label x:Name="OutOfStockLabel" Content="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Left" Height="70" Margin="265,111,0,0" VerticalAlignment="Top" Width="86" FontSize="40" FontWeight="Bold"/>




        <Grid Width="1123" Height="642" Margin="0,9,0,-7">
            <lvc:CartesianChart x:Name="GrowthAndTrendsAnalysis"
                        Background="White"
                        Width="717" Height="214"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="375,107,0,0" />
            <Label x:Name="ChartName" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Content="Growth Trends and Analysis" HorizontalAlignment="Left" Height="32" Margin="577,326,0,0" VerticalAlignment="Top" Width="342" FontStyle="Italic" FontWeight="Bold"/>
        </Grid>




    </Grid>
</UserControl>
