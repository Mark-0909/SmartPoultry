<Window x:Class="SmartPoultry.Sales_OrderInfo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartPoultry"
        mc:Ignorable="d"
        Title="Home_Checkout" Height="601" Width="300" 
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" 
        WindowStyle="None" Background="Transparent" 
        Foreground="Transparent" AllowsTransparency="True">
    <Window.Resources>
        <Style x:Key="NoHoverButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <!-- Animation for the button itself when hovered -->
                                            <DoubleAnimation 
                                            Storyboard.TargetProperty="Opacity" 
                                            To=".7" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>

                                            <DoubleAnimation 
                                            Storyboard.TargetProperty="Opacity" 
                                            To="1.0" Duration="0:0:0.3" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Border CornerRadius="10 10 10 10" BorderBrush="#FF2C6E5D" Background="White" BorderThickness="2" RenderTransformOrigin="0.5,0.5" Height="595" VerticalAlignment="Center" Margin="-1,0,1,0">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleX="0.182"/>
                    <RotateTransform/>
                    <TranslateTransform X="0.506"/>
                </TransformGroup>
            </Border.RenderTransform>
            <Border BorderBrush="#FF2C6E5D" CornerRadius="10 10 0 0" BorderThickness="1" HorizontalAlignment="Center" Height="41" Margin="0,-2,0,0" VerticalAlignment="Top" Width="301" Background="#FF2C6E5D">
                <Label HorizontalAlignment="Center" Foreground="White" VerticalAlignment="Center" Content="ORDER INFORMATION" FontSize="18" FontWeight="Bold"/>
            </Border>
        </Border>
        <Label Content="TOTAL AMOUNT:" VerticalContentAlignment="Center" HorizontalAlignment="Left" Height="38" Margin="10,412,0,0" VerticalAlignment="Top" Width="150" FontWeight="Bold"/>
        <Label Content="₱" HorizontalAlignment="Left" VerticalContentAlignment="Center" Height="38" Margin="147,411,0,0" VerticalAlignment="Top" Width="26" FontSize="16"/>
        <Label x:Name="totalPricelabel" Content="PRICE" HorizontalAlignment="Right" HorizontalContentAlignment="Right" Height="30" Margin="0,418,12,0" VerticalAlignment="Top" Width="102" FontWeight="Bold"/>
        <Button x:Name="CloseButton" Click="CloseWindow_Click" HorizontalAlignment="Left" Height="28" Margin="271,10,0,0" VerticalAlignment="Top" Width="26" Background="Transparent" BorderBrush="Transparent"  Style="{StaticResource NoHoverButton}">
            <Image Height="17" Width="20" Source="/Images/close.png"/>
        </Button>
        <Label Content="Order ID:" HorizontalAlignment="Left" Height="38" Margin="5,49,0,0" VerticalAlignment="Top" Width="90" FontSize="14" FontWeight="Bold"/>
        <Label Content="Item" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Height="38" Margin="43,108,0,0" VerticalAlignment="Top" Width="70" FontWeight="Bold"/>
        <Label Content="Price" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Height="38" Margin="207, 108,0,0" VerticalAlignment="Top" Width="82" FontWeight="Bold"/>
        <Label Content="Qty" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Height="38" Margin="113,108,0,0" VerticalAlignment="Top" Width="94" FontWeight="Bold"/>

        <ScrollViewer x:Name="OrderScroller"  HorizontalAlignment="Center" Height="276" Margin="0,139,0,0" VerticalAlignment="Top" Width="280">
            <WrapPanel x:Name="OrderWPanel" Margin="0,0,0,0" Width="270">
                <Border x:Name="OrderBorder" BorderBrush="Transparent" BorderThickness="1" Height="35" Width="255">
                    <WrapPanel>
                        <Label x:Name="itemNameLabel"  Content="Label" Height="33" Width="127" HorizontalContentAlignment="Center"
                   VerticalContentAlignment="Center" Background="Transparent"/>
                        <Label x:Name="QtyLabel" Content="Label" Height="33" Width="43" HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center" Background="Transparent"/>
                        <Label x:Name="PriceLabel" Content="Label" Height="33" Width="83" HorizontalContentAlignment="Right"
                VerticalContentAlignment="Center" Background="Transparent"/>
                    </WrapPanel>
                </Border>
            </WrapPanel>
        </ScrollViewer>
        <Label x:Name="OrderIdLabel" Content="Order ID:" HorizontalContentAlignment="Right" HorizontalAlignment="Left" Height="26" Margin="138,49,0,0" VerticalAlignment="Top" Width="150" FontSize="14"/>
        <Label Content="Payment Method:" VerticalContentAlignment="Center" HorizontalAlignment="Left" Height="28" Margin="10,450,0,0" VerticalAlignment="Top" Width="150" FontWeight="Bold" FontSize="11"/>
        <Label Content="Payment Status:" VerticalContentAlignment="Center" HorizontalAlignment="Left" Height="28" Margin="10,477,0,0" VerticalAlignment="Top" Width="150" FontWeight="Bold" FontSize="11"/>
        <Label Content="Purchase Method:" VerticalContentAlignment="Center" HorizontalAlignment="Left" Height="28" Margin="10,505,0,0" VerticalAlignment="Top" Width="150" FontWeight="Bold" FontSize="11"/>

        <Label x:Name="PayMethodLabel" HorizontalContentAlignment="Left" Content="Payment Method" VerticalContentAlignment="Center" HorizontalAlignment="Left" Height="28" Margin="113,450,0,0" VerticalAlignment="Top" Width="104" FontSize="11"/>
        <Label x:Name="PaymentStatusLabel" HorizontalContentAlignment="Left" Content="Payment status" VerticalContentAlignment="Center" HorizontalAlignment="Left" Height="28" Margin="113,478,0,0" VerticalAlignment="Top" Width="104" FontSize="11"/>
        <Label x:Name="PurchaseMethodlabel" HorizontalContentAlignment="Left" Content="purchase method" VerticalContentAlignment="Center" HorizontalAlignment="Left" Height="28" Margin="113,505,0,0" VerticalAlignment="Top" Width="104" FontSize="11"/>
        <Label Content="Cashier:" VerticalContentAlignment="Center" HorizontalAlignment="Left" Height="28" Margin="10,533,0,0" VerticalAlignment="Top" Width="150" FontWeight="Bold" FontSize="11"/>
        <Label x:Name="CashierLabel" HorizontalContentAlignment="Left" Content="cashier" VerticalContentAlignment="Center" HorizontalAlignment="Left" Height="28" Margin="113,533,0,0" VerticalAlignment="Top" Width="104" FontSize="11"/>
        <Label Content="Purchase Date:" HorizontalAlignment="Left" Height="38" Margin="5,80,0,0" VerticalAlignment="Top" Width="108" FontSize="14" FontWeight="Bold"/>
        <Label x:Name="PurchaseDatelabel" Content="Purchase Date" HorizontalContentAlignment="Right" HorizontalAlignment="Left" Height="26" Margin="138,80,0,0" VerticalAlignment="Top" Width="151" FontSize="14" RenderTransformOrigin="0.445,1.553"/>
        <Border CornerRadius="0, 0, 10, 0" BorderBrush="#FFA6C897" BorderThickness="1" HorizontalAlignment="Left" Height="34" Margin="150,563,0,0" VerticalAlignment="Top" Width="149" Background="#FFA6C897" >
            <Button x:Name="GenerateReceiptBtn" Click="GenerateReceiptBtn_Click" HorizontalAlignment="Center" Height="34" VerticalAlignment="Center" Width="138" Background="#FFA6C897" BorderBrush="Transparent" Content="RECEIPT" FontWeight="Bold"   Style="{StaticResource NoHoverButton}"/>
        </Border>
        <Border CornerRadius="0, 0, 0, 10" BorderBrush="#FFFB8989" BorderThickness="1" Height="34" Margin="2,563,150,0" VerticalAlignment="Top" Background="#FFFB8989">
            <Button x:Name="VoidBtn" Click="VoidBtn_Click" HorizontalAlignment="Center" Height="34" VerticalAlignment="Center" Width="136" Background="#FFFB8989" BorderBrush="#FFFB8989" Content="VOID" FontWeight="Bold"  Style="{StaticResource NoHoverButton}"/>
        </Border>
    </Grid>


</Window>
