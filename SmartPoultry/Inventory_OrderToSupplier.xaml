<Window x:Class="SmartPoultry.Inventory_OrderToSupplier"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartPoultry"
        mc:Ignorable="d"
        Title="Add_Delivery" Height="487" Width="432" WindowStartupLocation="CenterScreen" Background="Transparent" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True">
    <Window.Resources>
        <Style x:Key="NoHoverButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}" 
                        BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <!-- Animation for the button itself when hovered -->
                                            <DoubleAnimation 
                                        Storyboard.TargetProperty="Opacity" 
                                        To=".7" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>

                                            <DoubleAnimation 
                                        Storyboard.TargetProperty="Opacity" 
                                        To="1.0" Duration="0:0:0.3" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Border x:Name="Overlay" BorderBrush="#FFA7A7A7" Background="#FFA7A7A7" CornerRadius="10" Opacity=".5" BorderThickness="1" HorizontalAlignment="Center" Height="486" VerticalAlignment="Center" Width="432"/>
        <Border CornerRadius="10" BorderBrush="#FF2C6E5D" Background="White" BorderThickness="1" Margin="0,0,0,1">
            <Border CornerRadius="10 10 0 0" BorderBrush="#FF2C6E5D" BorderThickness="1" HorizontalAlignment="Center" Height="38" Margin="0,-1,0,0" VerticalAlignment="Top" Width="432" Background="#FF2C6E5D">
                <Button Click="Close_Click" Height="26" Margin="394,0,5,0" VerticalAlignment="Center" Background="#FF2C6E5D" BorderBrush="#FF2C6E5D">
                    <Image Height="24" Width="19" Source="/Images/close.png"/>
                </Button>
            </Border>
        </Border>
        <Label HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Content="ORDER SUPPLIES" HorizontalAlignment="Center" Height="35" VerticalAlignment="Top" Width="220" FontSize="20" Foreground="White" FontWeight="Bold"/>
        <Border CornerRadius="0 0 10 10" BorderBrush="#FF2C6E5D" BorderThickness="1" HorizontalAlignment="Center" Height="32" Margin="0,455,0,0" VerticalAlignment="Top" Width="432" Background="#FF2C6E5D">
            <Button x:Name="confirmBtn" Content="CONFIRM" HorizontalAlignment="Center" Height="27" VerticalAlignment="Center" Width="412" BorderBrush="#FF2C6E5D" Background="#FF2C6E5D" FontSize="15" Click="ConfirmButton_Click" Foreground="White" FontWeight="Bold"/>
        </Border>
        <StackPanel HorizontalAlignment="Center" Height="397" Margin="0,53,0,0" VerticalAlignment="Top" Width="412">
            <!-- Search Section -->
            <WrapPanel Height="48" Width="408">
                <Label Content="Search Product:" Height="38" Width="175" />



                <Border CornerRadius="5" BorderBrush="Black" BorderThickness="1" Height="38" Width="147">
                    <WrapPanel>
                        <ComboBox x:Name="SearchCBox" Tag="Search Product..." BorderBrush="White"
                  PreviewTextInput="SearchCBox_PreviewTextInput" IsEditable="True"  Margin="3"
                  IsDropDownOpen="False" Height="28" Width="135" PreviewMouseDown="SearchCBox_PreviewMouseDown" KeyDown="SearchCBox_KeyDown" LostFocus="SearchCBox_LostFocus" />

                        <Button x:Name="SearchBTN" Width="25" Height="25" Background="White" 
                VerticalAlignment="Center" HorizontalAlignment="Right" 
                Margin="-27,0,0,0" BorderBrush="Transparent" 
                Click="SearchBTN_Click">
                            <Image Height="22" Width="20" Source="/Images/2946467-200.png"/>
                        </Button>
                    </WrapPanel>
                </Border>



            </WrapPanel>



            <!-- Scrollable Content -->
            <ScrollViewer Height="345" Width="408" Margin="0,10,0,0">
                <WrapPanel x:Name="Wpanel" Width="382" />
            </ScrollViewer>
        </StackPanel>

        <Border x:Name="NotifPopup"  CornerRadius="10" BorderBrush="#FFCCE6D3" BorderThickness="1" HorizontalAlignment="Center" Height="46" Margin="0,24,0,0" VerticalAlignment="Top" Width="330" Background="#FFCCE6D3">
            <WrapPanel>
                <Label x:Name="NotifMessage"  Content="Invalid Credentials" VerticalContentAlignment="Center" Padding="20 0 0 0" Height="43" Width="302" Foreground="#FF666666"/>
                <Button x:Name="NotifCloseBtn" BorderBrush="Transparent" Background="Transparent" Height="20" Width="21" Click="NotifCloseBtn_Click"  Style="{StaticResource NoHoverButton}">
                    <Image Height="16" Width="10" Source="/Images/closegray.png"/>
                </Button>
            </WrapPanel>
        </Border>



    </Grid>
</Window>
