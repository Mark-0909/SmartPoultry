<UserControl x:Class="SmartPoultry.inventoryAdd_variationscontrol"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SmartPoultry"
             mc:Ignorable="d" Background="#FFDDDDDD" Width="58" Height="150">
    <UserControl.Resources>
        <Style x:Key="NoHoverButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation 
                                                Storyboard.TargetProperty="Opacity" 
                                                To=".7" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation 
                                                Storyboard.TargetProperty="Opacity" 
                                                To="1.0" Duration="0:0:0.3" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="0,0,0,0">
        <!-- Unit Template -->
        <Border x:Name="unitTemplate" 
                MouseLeftButtonDown="UserControl_MouseLeftButtonDown" 
                CornerRadius="10" 
                BorderThickness="1" 
                BorderBrush="#FF66C265" 
                Background="#FFC0E4BE" 
                Margin="0,-25,0,81" 
                Height="36">
            <Button x:Name="nameBtn" 
                    Margin="3" 
                    BorderBrush="#FFC0E4BE" 
                    Background="#FFC0E4BE" 
                    Style="{StaticResource NoHoverButton}" 
                    Content="Unit" 
                    Foreground="#FF66C265" 
                    FontSize="14" 
                    HorizontalContentAlignment="Center" 
                    VerticalContentAlignment="Center" 
                    Click="NameBtn_Click"/>
        </Border>

        <!-- Price Template -->
        <Border x:Name="priceTemplate" 
                MouseLeftButtonDown="UserControl_MouseLeftButtonDown" 
                CornerRadius="10" 
                BorderBrush="#FF66C265" 
                BorderThickness="1" 
                Background="#FFC0E4BE" 
                Margin="0,25,0,43" 
                Height="36">
            <Label x:Name="priceLabel" 
                   Content="Price" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center" 
                   Background="#FFC0E4BE" 
                   BorderBrush="#FFC0E4BE" 
                   Foreground="#FF66C265" 
                   FontSize="14"/>
        </Border>

        <!-- Conversion Template -->
        <Border x:Name="conversionTemplate" 
                MouseLeftButtonDown="UserControl_MouseLeftButtonDown" 
                CornerRadius="10" 
                BorderBrush="#FF66C265" 
                BorderThickness="1" 
                Background="#FFC0E4BE" 
                Margin="0,75,0,5" 
                Height="36">
            <Label x:Name="conversionLabel" 
                   Content="conv." 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center" 
                   Background="#FFC0E4BE" 
                   BorderBrush="#FFC0E4BE" 
                   Foreground="#FF66C265" 
                   FontSize="14"/>
        </Border>

        <!-- Remove Button -->
        <Border CornerRadius="100" 
                BorderBrush="#FFEC7373" 
                BorderThickness="1" 
                HorizontalAlignment="Right" 
                VerticalAlignment="Top" 
                Height="16" 
                Width="16" 
                Background="#FFEC7373" 
                Margin="0,4,5,0">
            <Button Margin="3,2,3,2" 
                    Background="#FFEC7373" 
                    BorderBrush="#FFEC7373" 
                    Padding="0" 
                    Style="{StaticResource NoHoverButton}" 
                    Click="RemoveButton_Click">
                <Image Height="6" 
                       Width="6" 
                       Source="/Images/close.png"/>
            </Button>
        </Border>
    </Grid>
</UserControl>
