<UserControl x:Class="SmartPoultry.inventoryAdd_variationscontrol"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SmartPoultry"
             mc:Ignorable="d" Background="#FFDDDDDD" Width="60" Height="163">
    <UserControl.Resources>
        <Style x:Key="NoHoverButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation 
                                            Storyboard.TargetProperty="Opacity" 
                                            To=".7" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation 
                                            Storyboard.TargetProperty="Opacity" 
                                            To="1.0" Duration="0:0:0.3" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Border x:Name="unitTemplate" CornerRadius="10" 
            BorderThickness="1" BorderBrush="#FF66C265" Background="#FFC0E4BE" Margin="2,2,2,106" Width="56" Height="55">
            <Button x:Name="nameBtn" Margin="3,4,3,4" BorderBrush="#FFC0E4BE" Background="#FFC0E4BE" Style="{StaticResource NoHoverButton}" Content="Unit" Foreground="#FF66C265" FontSize="15" Click="NameBtn_Click"/>
        </Border>
        <Border x:Name="priceTemplate" CornerRadius="10" BorderBrush="#FF66C265" BorderThickness="1" Background="#FFC0E4BE" Margin="2,61,2,60" Width="56">
            <Label x:Name="priceLabel" Content="Price" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#FFC0E4BE" BorderBrush="#FFC0E4BE" Foreground="#FF66C265" FontSize="15" Height="31" />
        </Border>
        <Border x:Name="conversionTemplate" CornerRadius="10" BorderBrush="#FF66C265" BorderThickness="1" Background="#FFC0E4BE" Margin="2,108,2,13" Width="56" Height="42">
            <Label x:Name="conversionLabel" Content="conv." HorizontalAlignment="Center" VerticalAlignment="Center" Background="#FFC0E4BE" BorderBrush="#FFC0E4BE" Foreground="#FF66C265" FontSize="15" />
        </Border>

    </Grid>
</UserControl>
