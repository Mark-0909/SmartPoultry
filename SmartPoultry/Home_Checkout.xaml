<Window x:Class="SmartPoultry.Home_Checkout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartPoultry"
        mc:Ignorable="d"
        Title="Home_Checkout" Height="568" Width="589" 
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" 
        WindowStyle="None" Background="Transparent" 
        Foreground="Transparent" AllowsTransparency="True">
    <Grid>
        <Border CornerRadius="10 10 10 10" BorderBrush="#FF2C6E5D" Background="White" BorderThickness="2
                " RenderTransformOrigin="0.5,0.5" Height="566" VerticalAlignment="Center" Margin="-1,0,1,0">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleX="0.182"/>
                    <RotateTransform/>
                    <TranslateTransform X="0.506"/>
                </TransformGroup>
            </Border.RenderTransform>
            <Border BorderBrush="#FF2C6E5D" CornerRadius="10 10 0 0" BorderThickness="1" HorizontalAlignment="Center" Height="41" Margin="0,-2,0,0" VerticalAlignment="Top" Width="585" Background="#FF2C6E5D">
                <Label HorizontalAlignment="Center" Foreground="White" VerticalAlignment="Center" Content="CHECKOUT" FontSize="20" FontWeight="Bold"/>
            </Border>
        </Border>
        <Label Content="TOTAL AMOUNT:" HorizontalAlignment="Left" Height="38" Margin="315,113,0,0" VerticalAlignment="Top" Width="150" FontSize="16" FontWeight="Bold"/>
        <Label Content="₱" HorizontalAlignment="Left" Height="38" Margin="315,151,0,0" VerticalAlignment="Top" Width="26" FontSize="16"/>
        <Label x:Name="totalPricelabel" Content="PRICE" HorizontalAlignment="Right" HorizontalContentAlignment="Right" Height="38" Margin="0,151,19,0" VerticalAlignment="Top" Width="100" FontSize="16"/>
        <Label Content="Payment Details:" HorizontalAlignment="Left" Height="38" Margin="315,189,0,0" VerticalAlignment="Top" Width="150" FontSize="16" FontWeight="Bold"/>
        <Label Content="Status:" HorizontalAlignment="Left" Height="33" Margin="315,295,0,0" VerticalAlignment="Top" Width="150" FontSize="16" FontWeight="Bold"/>
        <Label Content="Purchased Method:" HorizontalAlignment="Left" Height="32" Margin="315,395,0,0" VerticalAlignment="Top" Width="150" FontSize="16" FontWeight="Bold"/>
        <Button x:Name="CloseButton" Click="CloseWindow_Click" HorizontalAlignment="Left" Height="30" Margin="554,5,0,0" VerticalAlignment="Top" Width="27" Background="Transparent" BorderBrush="Transparent">
            <Image Height="22" Width="24" Source="/Images/close.png"/>
        </Button>
        <Border BorderBrush="#FF2C6E5D" CornerRadius="0 0 10 0" BorderThickness="1" HorizontalAlignment="Left" Height="38" VerticalAlignment="Top" Width="186" Background="#FF2C6E5D" Margin="403,529,0,0">
            <Button x:Name="ConfirmBtn" Click="Confirm_Click" Content="Next" HorizontalAlignment="Center" Height="32" VerticalAlignment="Center" Width="166" Background="#FF2C6E5D" BorderBrush="#FF2C6E5D" Foreground="White" FontWeight="Bold" FontSize="20"/>
        </Border>


        <RadioButton Checked="GCashRadioButton_Checked" Content="Gcash" GroupName="PaymentMethod" HorizontalAlignment="Left" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="315,261,0,0" VerticalAlignment="Top" FontSize="20" Foreground="#FF5E5E5E" Height="34" />
        <RadioButton Checked="CashRadioButton_Checked" IsChecked="True" Content="Cash" GroupName="PaymentMethod" HorizontalAlignment="Left" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="315,227,0,0" VerticalAlignment="Top" FontSize="20" Foreground="#FF5E5E5E" Height="34" />


        <RadioButton Checked="PaidRadioButton_Checked" IsChecked="True" Content="Paid" GroupName="PaymentStatus" HorizontalAlignment="Left" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="315,333,0,0" VerticalAlignment="Top" FontSize="20" Foreground="#FF5E5E5E" />
        <RadioButton Checked="UnpaidRadioButton_Checked" Content="Unpaid" GroupName="PaymentStatus" HorizontalAlignment="Left" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="315,364,0,0" VerticalAlignment="Top" FontSize="20" Foreground="#FF5E5E5E" />


        <RadioButton Checked="UpfrontRadioButton_Checked" IsChecked="True" Content="Upfront" GroupName="PurchaseType" HorizontalAlignment="Left" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="315,432,0,0" VerticalAlignment="Top" FontSize="20" Foreground="#FF5E5E5E" />
        <RadioButton Checked="ToDeliverRadioButton_Checked" Content="To Deliver" GroupName="PurchaseType" HorizontalAlignment="Left" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="315,463,0,0" VerticalAlignment="Top" FontSize="20" Foreground="#FF5E5E5E" />
        <Border x:Name="BackBtnBorder" BorderBrush="#FF2C6E5D" CornerRadius="0 0 0 10" BorderThickness="1" HorizontalAlignment="Left" Height="38" VerticalAlignment="Top" Width="186" Background="#FF2C6E5D" Margin="2,529,0,0">
            <Button Click="Confirm_Click" Content="Back" HorizontalAlignment="Center" Height="32" VerticalAlignment="Center" Width="166" Background="#FF2C6E5D" BorderBrush="#FF2C6E5D" Foreground="White" FontWeight="Bold" FontSize="20"/>
        </Border>
        <Label Content="Orders:" HorizontalAlignment="Left" Height="38" Margin="20,85,0,0" VerticalAlignment="Top" Width="150" FontSize="16" FontWeight="Bold"/>
        <Label Content="Item" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Height="38" Margin="51,113,0,0" VerticalAlignment="Top" Width="70" FontSize="16" FontWeight="Bold"/>
        <Label Content="Price" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Height="38" Margin="196,113,0,0" VerticalAlignment="Top" Width="82" FontSize="16" FontWeight="Bold"/>
        <Label Content="Qty" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Height="38" Margin="121,113,0,0" VerticalAlignment="Top" Width="93" FontSize="16" FontWeight="Bold"/>
        <Label Content="PAYMENT METHOD" HorizontalAlignment="Left" Height="38" Margin="20,47,0,0" VerticalAlignment="Top" Width="178" FontSize="16" FontWeight="Bold" RenderTransformOrigin="0.5,0.5">
            <Label.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleY="-0.215"/>
                    <RotateTransform/>
                    <TranslateTransform Y="-0.282"/>
                </TransformGroup>
            </Label.RenderTransform>
        </Label>

        <ScrollViewer x:Name="OrderScroller"  HorizontalAlignment="Left" Height="416" Margin="10,142,0,0" VerticalAlignment="Top" Width="281">
            <WrapPanel x:Name="OrderWPanel" Margin="0,0,0,0" Width="270">
                <Border x:Name="OrderBorder" BorderBrush="Transparent" BorderThickness="1" Height="35" Width="255">
                    <WrapPanel>
                        <Label x:Name="itemNameLabel"  Content="Label" Height="33" Width="127" HorizontalContentAlignment="Center"
                   VerticalContentAlignment="Center" Background="Transparent"/>
                        <Label x:Name="QtyLabel" Content="Label" Height="33" Width="43" HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center" Background="Transparent"/>
                        <Label x:Name="PriceLabel" Content="Label" Height="33" Width="83" HorizontalContentAlignment="Right"
                VerticalContentAlignment="Center" Background="Transparent"/>
                    </WrapPanel>
                </Border>
            </WrapPanel>
        </ScrollViewer>
        <Border BorderBrush="#FF2C6E5D" BorderThickness="1" HorizontalAlignment="Center" Height="474" VerticalAlignment="Top" Width="2" Background="#FF2C6E5D" Margin="8,113,0,0"/>


    </Grid>


</Window>
