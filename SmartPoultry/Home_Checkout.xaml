<Window x:Class="SmartPoultry.Home_Checkout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartPoultry"
        mc:Ignorable="d"
        Title="Home_Checkout" Height="568" Width="589" 
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" 
        WindowStyle="None" Background="Transparent" 
        Foreground="Transparent" AllowsTransparency="True">
    <Grid>
        <Border CornerRadius="10 10 10 10" BorderBrush="#FF2C6E5D" Background="White" BorderThickness="2" RenderTransformOrigin="0.5,0.5" Height="568" VerticalAlignment="Center" Margin="-1,0,1,0">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleX="0.182"/>
                    <RotateTransform/>
                    <TranslateTransform X="0.506"/>
                </TransformGroup>
            </Border.RenderTransform>
            <Border BorderBrush="#FF2C6E5D" CornerRadius="10 10 0 0" BorderThickness="1" HorizontalAlignment="Center" Height="41" Margin="0,-2,0,0" VerticalAlignment="Top" Width="585" Background="#FF2C6E5D">
                <Label HorizontalAlignment="Center" Foreground="White" VerticalAlignment="Center" Content="CHECKOUT" FontSize="20" FontWeight="Bold"/>
            </Border>
        </Border>
        <Label Content="TOTAL AMOUNT:" VerticalContentAlignment="Center" HorizontalAlignment="Left" Height="38" Margin="5,526,0,0" VerticalAlignment="Top" Width="150" FontSize="16" FontWeight="Bold"/>
        <Label Content="₱" HorizontalAlignment="Left" VerticalContentAlignment="Center" Height="38" Margin="150,526,0,0" VerticalAlignment="Top" Width="26" FontSize="16"/>
        <Label x:Name="totalPricelabel" Content="PRICE" HorizontalAlignment="Right" HorizontalContentAlignment="Right" Height="38" Margin="0,526,298,0" VerticalAlignment="Top" Width="103" FontSize="16"/>
        <Label Content="Payment Method:" HorizontalAlignment="Left" Height="38" Margin="313,46,0,0" VerticalAlignment="Top" Width="150" FontSize="16" FontWeight="Bold"/>
        <Label Content="Status:" HorizontalAlignment="Left" Height="33" Margin="313,108,0,0" VerticalAlignment="Top" Width="150" FontSize="16" FontWeight="Bold"/>
        <Label Content="Purchased Method:" HorizontalAlignment="Left" Height="32" Margin="313,171,0,0" VerticalAlignment="Top" Width="150" FontSize="16" FontWeight="Bold"/>
        <Button x:Name="CloseButton" Click="CloseWindow_Click" HorizontalAlignment="Left" Height="30" Margin="554,5,0,0" VerticalAlignment="Top" Width="27" Background="Transparent" BorderBrush="Transparent">
            <Image Height="22" Width="24" Source="/Images/close.png"/>
        </Button>
        <Border BorderBrush="#FF2C6E5D" CornerRadius="0 0 10 0" BorderThickness="1" HorizontalAlignment="Left" Height="38" VerticalAlignment="Top" Width="290" Background="#FF2C6E5D" Margin="299,529,0,0">
            <Button x:Name="ConfirmBtn" Click="Confirm_Click" Content="Confirm" HorizontalAlignment="Center" Height="32" VerticalAlignment="Center" Width="166" Background="#FF2C6E5D" BorderBrush="#FF2C6E5D" Foreground="White" FontWeight="Bold" FontSize="20"/>
        </Border>


        <RadioButton Checked="GCashRadioButton_Checked" Content="Gcash" GroupName="PaymentMethod" HorizontalAlignment="Left" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="376,78,0,0" VerticalAlignment="Top" FontSize="16" Foreground="#FF5E5E5E" Height="34" />
        <RadioButton Checked="CashRadioButton_Checked" IsChecked="True" Content="Cash" GroupName="PaymentMethod" HorizontalAlignment="Left" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="313,78,0,0" VerticalAlignment="Top" FontSize="16" Foreground="#FF5E5E5E" Height="34" />


        <RadioButton Checked="PaidRadioButton_Checked" IsChecked="True" Content="Paid" GroupName="PaymentStatus" HorizontalAlignment="Left" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="313,141,0,0" VerticalAlignment="Top" FontSize="16" Foreground="#FF5E5E5E" Height="29" />
        <RadioButton Checked="UnpaidRadioButton_Checked" Content="Unpaid" GroupName="PaymentStatus" HorizontalAlignment="Left" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="372,138,0,0" VerticalAlignment="Top" FontSize="16" Foreground="#FF5E5E5E" Height="34" />


        <RadioButton Checked="UpfrontRadioButton_Checked" IsChecked="True" Content="Upfront" GroupName="PurchaseType" HorizontalAlignment="Left" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="313,203,0,0" VerticalAlignment="Top" FontSize="16" Foreground="#FF5E5E5E" Height="34" />
        <RadioButton Checked="ToDeliverRadioButton_Checked" Content="To Deliver" GroupName="PurchaseType" HorizontalAlignment="Left" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="397,203,0,0" VerticalAlignment="Top" FontSize="16" Foreground="#FF5E5E5E" Height="34" />
        <Label Content="Orders:" HorizontalAlignment="Left" Height="38" Margin="5,46,0,0" VerticalAlignment="Top" Width="150" FontSize="16" FontWeight="Bold"/>
        <Label Content="Item" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Height="38" Margin="40,78,0,0" VerticalAlignment="Top" Width="70" FontSize="16" FontWeight="Bold"/>
        <Label Content="Price" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Height="38" Margin="203,78,0,0" VerticalAlignment="Top" Width="82" FontSize="16" FontWeight="Bold"/>
        <Label Content="Qty" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Height="38" Margin="110,78,0,0" VerticalAlignment="Top" Width="93" FontSize="16" FontWeight="Bold"/>

        <ScrollViewer x:Name="OrderScroller"  HorizontalAlignment="Left" Height="416" Margin="10,108,0,0" VerticalAlignment="Top" Width="281">
            <WrapPanel x:Name="OrderWPanel" Margin="0,0,0,0" Width="270">
                <Border x:Name="OrderBorder" BorderBrush="Transparent" BorderThickness="1" Height="35" Width="255">
                    <WrapPanel>
                        <Label x:Name="itemNameLabel"  Content="Label" Height="33" Width="127" HorizontalContentAlignment="Center"
                   VerticalContentAlignment="Center" Background="Transparent"/>
                        <Label x:Name="QtyLabel" Content="Label" Height="33" Width="43" HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center" Background="Transparent"/>
                        <Label x:Name="PriceLabel" Content="Label" Height="33" Width="83" HorizontalContentAlignment="Right"
                VerticalContentAlignment="Center" Background="Transparent"/>
                    </WrapPanel>
                </Border>
            </WrapPanel>
        </ScrollViewer>
        <Border BorderBrush="#FF2C6E5D" BorderThickness="1" HorizontalAlignment="Left" Height="525" VerticalAlignment="Top" Width="2" Background="#FF2C6E5D" Margin="298,41,0,0"/>
        <Label Content="Name:" HorizontalAlignment="Left" Height="27" Margin="311,237,0,0" VerticalAlignment="Top" Width="53" FontSize="14"/>
        <Border x:Name="NameBorder"  BorderBrush="#FF838383" CornerRadius="5" BorderThickness="1" HorizontalAlignment="Left" Height="27" VerticalAlignment="Top" Width="268" Background="White" Margin="311,264,0,0">
            <TextBox x:Name="NameTB" VerticalContentAlignment="Center" HorizontalAlignment="Center" Height="30" TextWrapping="Wrap"
             Text="Name..." Tag="Name..." VerticalAlignment="Center" Width="258" 
             BorderBrush="White" Foreground="Gray" GotFocus="TB_GotFocus" LostFocus="TB_LostFocus"/>
        </Border>

        <Label Content="Pay Date:" HorizontalAlignment="Left" Height="27" Margin="311,291,0,0" VerticalAlignment="Top" Width="74" FontSize="14"/>
        <Label Content="Delivery Date:" HorizontalAlignment="Left" Height="27" Margin="442,291,0,0" VerticalAlignment="Top" Width="103" FontSize="14"/>

        <Border x:Name="DPpaymentborder"  CornerRadius="5" BorderBrush="Gray" BorderThickness="1" HorizontalAlignment="Left" Height="30" Margin="311,318,0,0" VerticalAlignment="Top" Width="126">
            <DatePicker x:Name="datePickerPayment" VerticalContentAlignment="Center" HorizontalAlignment="Left" Height="30" VerticalAlignment="Center" Width="119" Loaded="DatePicker_Loaded" Margin="4,0,0,0" BorderBrush="Transparent" FontSize="14" Foreground="Gray"/>
        </Border>
        <Border x:Name="DPdeliverborder" CornerRadius="5" BorderBrush="Gray" BorderThickness="1" HorizontalAlignment="Left" Height="30" Margin="445,318,0,0" VerticalAlignment="Top" Width="126" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleY="-0.106"/>
                    <RotateTransform/>
                    <TranslateTransform Y="-0.189"/>
                </TransformGroup>
            </Border.RenderTransform>
            <DatePicker x:Name="datePickerDelivery" VerticalContentAlignment="Center" HorizontalAlignment="Left" Height="30" VerticalAlignment="Center" Width="119" Loaded="DatePicker_Loaded" Margin="4,0,0,0" BorderBrush="Transparent" FontSize="14" Foreground="Gray"/>
        </Border>
        <Border x:Name="ContactsBorder"  BorderBrush="#FF838383" CornerRadius="5" BorderThickness="1" HorizontalAlignment="Left" Height="27" VerticalAlignment="Top" Width="268" Background="White" Margin="313,434,0,0">
            <TextBox x:Name="ContactsTB" VerticalContentAlignment="Center" HorizontalAlignment="Center" Height="30" TextWrapping="Wrap"
             Text="Contacts..." Tag="Contacts..." VerticalAlignment="Center" Width="258" 
             BorderBrush="White" Foreground="Gray" GotFocus="TB_GotFocus" LostFocus="TB_LostFocus" />
        </Border>
        <Border x:Name="AddressBorder" BorderBrush="#FF838383" CornerRadius="5" BorderThickness="1" HorizontalAlignment="Left" Height="27" VerticalAlignment="Top" Width="268" Background="White" Margin="313,375,0,0">
            <TextBox x:Name="AddressTB" VerticalContentAlignment="Center" HorizontalAlignment="Center" Height="30" TextWrapping="Wrap"
             Text="Address..." Tag="Address..." VerticalAlignment="Center" Width="258"
             BorderBrush="White" Foreground="Gray" GotFocus="TB_GotFocus" LostFocus="TB_LostFocus" />
        </Border>
        <Border x:Name="ChargeBorder" BorderBrush="#FF838383" CornerRadius="5" BorderThickness="1" HorizontalAlignment="Left" Height="27" VerticalAlignment="Top" Width="268" Background="White" Margin="311,493,0,0" >
            <TextBox x:Name="ChargeTB" VerticalContentAlignment="Center" HorizontalAlignment="Center" Height="30" TextWrapping="Wrap"
             Text="Charge Fee..." Tag="Charge Fee..." VerticalAlignment="Center" Width="258" 
             BorderBrush="White" Foreground="Gray" GotFocus="TB_GotFocus" LostFocus="TB_LostFocus" TextChanged="ChargeFee_TextChanged"/>
        </Border>

        <Label Content="Address:" HorizontalAlignment="Left" Height="27" Margin="311,348,0,0" VerticalAlignment="Top" Width="74" FontSize="14"/>
        <Label Content="Contacts:" HorizontalAlignment="Left" Height="27" Margin="311,407,0,0" VerticalAlignment="Top" Width="74" FontSize="14"/>
        <Label Content="Charge Fee:" HorizontalAlignment="Left" Height="27" Margin="311,466,0,0" VerticalAlignment="Top" Width="85" FontSize="14"/>
    </Grid>


</Window>
