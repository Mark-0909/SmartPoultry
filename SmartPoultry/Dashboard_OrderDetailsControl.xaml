<UserControl x:Class="SmartPoultry.Dashboard_OrderDetailsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SmartPoultry"
             mc:Ignorable="d" d:DesignWidth="475" Height="50" Margin="5 0 0 5">
    <Grid>
        <Border x:Name="thisBorder" CornerRadius="10" BorderBrush="#FFF8F8F8" Background="#FFDBDBDB" BorderThickness="1">
            <Label x:Name="nameLabel" Content="name" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Left" Height="50" Margin="9,0,0,0" VerticalAlignment="Center" Width="59"/>
        </Border>
        <Label x:Name="varLabel" Content="var" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Left" Height="50" Margin="96,0,0,0" VerticalAlignment="Center" Width="59"/>
        <Label x:Name="qtyLabel" Content="qty" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Left" Height="50" Margin="185,0,0,0" VerticalAlignment="Center" Width="59"/>
        <Label x:Name="priceLabel" Content="price" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Left" Height="50" Margin="267,0,0,0" VerticalAlignment="Center" Width="59"/>
        <Label x:Name="totalLabel" Content="total" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Left" Height="50" Margin="401,0,0,0" VerticalAlignment="Center" Width="59"/>
    </Grid>
</UserControl>
