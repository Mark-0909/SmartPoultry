        xmlns:local="clr-namespace:SmartPoultry"
        mc:Ignorable="d"
        Title="LoginPage" Height="363" Width="423" WindowStartupLocation="CenterScreen">
    <Grid>
        <Button x:Name="LoginBtn" Content="LOGIN" HorizontalAlignment="Center" Margin="0,223,0,0" VerticalAlignment="Top" Height="73" Width="160" Click="LoginButton_Click"/>
        <Image Margin="132,29,131,208" Source="/Images/smartpoultrylogin.png" Stretch="Fill"/>
        <TextBox HorizontalAlignment="Center" Margin="0,156,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120"/>
        <TextBox HorizontalAlignment="Center" Margin="0,191,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120"/>

    </Grid>
</Window>
