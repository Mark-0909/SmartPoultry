<Window x:Class="SmartPoultry.LoginPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartPoultry"
        mc:Ignorable="d"
        Title="LoginPage" Height="447" Width="620" WindowStartupLocation="CenterScreen" Background="#FF2C6E5D">
    <Grid>

        <Rectangle Height="334" Margin="339,56,36,0" Stroke="Black" VerticalAlignment="Top" Fill="#FF3B9669"/>

        <Button x:Name="LoginBtn" Content="" HorizontalAlignment="Left" Margin="402,307,0,0" VerticalAlignment="Top" Height="55" Width="120" Click="LoginButton_Click" BorderBrush="White" BorderThickness="0,0,0,0">
            <Button.Background>
                <ImageBrush ImageSource="/LOGIN DESIGN.png"/>
            </Button.Background>
        </Button>
        <TextBox HorizontalAlignment="Left" Height="25" Margin="362,179,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="200"/>
        <TextBox HorizontalAlignment="Left" Height="25" Margin="362,246,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="200"/>
        <Label Content="Username" HorizontalAlignment="Left" Height="30" Margin="362,144,0,0" VerticalAlignment="Top" Width="100"/>
        <Label Content="Password" HorizontalAlignment="Left" Height="30" Margin="362,211,0,0" VerticalAlignment="Top" Width="100"/>

    </Grid>
</Window>
