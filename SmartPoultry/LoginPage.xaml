<Window x:Class="SmartPoultry.LoginPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartPoultry"
        mc:Ignorable="d"
        Title="LoginPage" Height="457" Width="647" WindowStartupLocation="CenterScreen" Background="#FF2C6E5D">
    <Grid>

        <Rectangle Height="334" Margin="345,68,30,0" Stroke="Black" VerticalAlignment="Top" Fill="#FF3B9669"/>

        <Button x:Name="LoginBtn" Content="" HorizontalAlignment="Left" Margin="421,323,0,0" VerticalAlignment="Top" Height="55" Width="120" Click="LoginButton_Click" BorderBrush="White" BorderThickness="0,0,0,0">
            <Button.Background>
                <ImageBrush ImageSource="/LOGIN DESIGN.png"/>
            </Button.Background>
        </Button>
        <TextBox HorizontalAlignment="Left" Height="25" Margin="381,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center" Width="200" FontSize="14"/>
        <TextBox HorizontalAlignment="Left" Height="25" Margin="381,277,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="200" FontSize="14"/>
        <Label Content="Username" HorizontalAlignment="Left" Height="30" Margin="381,178,0,0" VerticalAlignment="Top" Width="100"/>
        <Label Content="Password" HorizontalAlignment="Left" Height="30" Margin="381,247,0,0" VerticalAlignment="Top" Width="100"/>
        <Image HorizontalAlignment="Left" Height="60" Margin="530,90,0,0" VerticalAlignment="Top" Width="60" Source="/qrcode.png"/>
        <Image HorizontalAlignment="Left" Height="70" Margin="381,91,0,0" VerticalAlignment="Top" Width="70" Source="/blacklogo.png"/>
        <Image HorizontalAlignment="Left" Height="129" Margin="99,99,0,0" VerticalAlignment="Top" Width="156" Source="/blacklogo.png"/>
        <Image HorizontalAlignment="Left" Height="80" Margin="35,245,0,0" VerticalAlignment="Top" Width="284" Source="/blacktext.png"/>
        <Button Content="" HorizontalAlignment="Left" Height="40" Margin="577,10,0,0" VerticalAlignment="Top" Width="40" Click="Button_Click" RenderTransformOrigin="-0.133,0.443">
            <Button.Background>
                <ImageBrush ImageSource="/logouticon.png"/>
            </Button.Background>
        </Button>

    </Grid>
</Window>
