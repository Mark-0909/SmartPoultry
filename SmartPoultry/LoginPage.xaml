<Window x:Class="SmartPoultry.LoginPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartPoultry"
        mc:Ignorable="d"
        Title="LoginPage" Height="652" Width="942" WindowStartupLocation="CenterScreen">
    <Grid Background="#FFC9C9C9">
        <Image HorizontalAlignment="Left" Height="254" Margin="134,95,0,0" VerticalAlignment="Top" Width="268" Source="/Images/smartpoultrylogin.png"/>
        <local:Login_CreateAccount x:Name="createAccountControl" HorizontalAlignment="Left" Margin="526,19,0,0" VerticalAlignment="Top"/>
        <local:Login_ForgotPassword x:Name="forgotControl" HorizontalAlignment="Left" Margin="526,42,0,0" VerticalAlignment="Top"/>
        <local:Login_LoginControl x:Name="loginControl" HorizontalAlignment="Left" Margin="526,123,0,0" VerticalAlignment="Top"/>

    </Grid>
</Window>
