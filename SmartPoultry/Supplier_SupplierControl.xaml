<UserControl x:Class="SmartPoultry.Supplier_SupplierControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SmartPoultry"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="600" Width="600" Height="97">
    <Grid>
        <Border CornerRadius="10" BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="White">
            <!-- Grid to arrange the information from left to right -->
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <!-- Name -->
                    <ColumnDefinition Width="*"/>
                    <!-- Contact Person -->
                    <ColumnDefinition Width="*"/>
                    <!-- Phone -->
                    <ColumnDefinition Width="*"/>
                    <!-- Email -->
                    <ColumnDefinition Width="*"/>
                    <!-- Address -->
                </Grid.ColumnDefinitions>

                <!-- Supplier Data Binding (Change these to bind actual supplier data) -->
                <TextBlock Text="{Binding SupplierName}" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Column="0"/>
                <TextBlock Text="{Binding ContactPerson}" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Column="1"/>
                <TextBlock Text="{Binding Phone}" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Column="2"/>
                <TextBlock Text="{Binding Email}" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Column="3"/>
                <TextBlock Text="{Binding Address}" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Column="4"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>

