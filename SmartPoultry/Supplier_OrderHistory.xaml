<Window x:Class="SmartPoultry.Supplier_OrderHistory"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartPoultry"
        mc:Ignorable="d"
        Title="Supplier_OrderHistory" Height="50" Width="364" Background="#FFF" WindowStyle="None">
    <Window.Resources>
        <Style x:Key="NoHoverButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation 
                                                Storyboard.TargetProperty="Opacity" 
                                                To=".7" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation 
                                                Storyboard.TargetProperty="Opacity" 
                                                To="1.0" Duration="0:0:0.3" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Main Border -->
        <Border CornerRadius="5" Background="#FFDBDBDB" BorderBrush="#FFDBDBDB" BorderThickness="1">
            <Grid>
                <!-- Date -->
                <Label Content="label" HorizontalAlignment="Left" Margin="30,0,0,0" VerticalAlignment="Center" Width="93" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>

                <!-- Status -->
                <Label Content="label" HorizontalAlignment="Left" Margin="160,0,0,0" VerticalAlignment="Center" Width="93" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>

                <!-- Actions (Info Button) -->
                <Button HorizontalAlignment="Left" Height="29" Margin="325,0,0,0" VerticalAlignment="Center" Width="31" BorderBrush="Transparent" Background="Transparent" Click="OrderDetail_Clicked" Style="{StaticResource NoHoverButton}">
                    <Image Height="23.5" Width="22" Source="/Images/infoicon.png"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
