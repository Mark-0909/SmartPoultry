<UserControl x:Class="SmartPoultry.Supplier_InfoUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="500">
    <!-- Overlay and Popup -->
    <Grid>
        <!-- Semi-transparent overlay -->
        

        <!-- Centered Border for the popup -->
        <Border BorderBrush="Black" BorderThickness="1" CornerRadius="10" 
                Width="500" Height="350" VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="White">
            <Grid>
                <!-- Close Button -->
                <Button Content="Exit" HorizontalAlignment="Right" VerticalAlignment="Top" 
                        Width="50" Height="25" Margin="0,10,10,0" Click="ExitButton_Click"/>

                <!-- Popup Content -->
                <StackPanel Margin="20">
                    <TextBlock Text="Edit Supplier Info" FontSize="20" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                    
                    <TextBlock Text="Name" />
                    <TextBox x:Name="SupplierName" Width="200" Margin="5" />

                    <TextBlock Text="Contact Person" />
                    <TextBox x:Name="ContactPerson" Width="200" Margin="5" />

                    <TextBlock Text="Phone" />
                    <TextBox x:Name="Phone" Width="200" Margin="5" />

                    <TextBlock Text="Email" />
                    <TextBox x:Name="Email" Width="200" Margin="5" />

                    <TextBlock Text="Address" />
                    <TextBox x:Name="Address" Width="200" Margin="5" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                        <Button Content="Save" Width="100" Margin="5" Click="SaveButton_Click" />
                        <Button Content="Delete" Width="100" Margin="5" Click="DeleteButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
