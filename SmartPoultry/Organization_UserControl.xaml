<UserControl x:Class="SmartPoultry.Organization_UserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SmartPoultry"
             mc:Ignorable="d" 
             d:DesignHeight="75" Width="580" Height="75" Background="Transparent" Margin="-4, 0, 0, 5" MouseLeftButtonDown="UserControl_MouseLeftButtonDown">
    <Grid>
        <Border x:Name="ControlBorder" CornerRadius="8" BorderBrush="#FFDBDBDB" BorderThickness="1" HorizontalAlignment="Center" Height="75" VerticalAlignment="Center" Width="565" Background="#FFDBDBDB">
            <WrapPanel HorizontalAlignment="Center" Height="74" VerticalAlignment="Center" Width="509">
                <Label x:Name="NameLabel" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Content="Name" Height="74" Width="254" FontSize="18"/>
                <Label x:Name="RoleLabel" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Content="Role" Height="74" Width="255" FontSize="18"/>
            </WrapPanel>
        </Border>

    </Grid>
</UserControl>
